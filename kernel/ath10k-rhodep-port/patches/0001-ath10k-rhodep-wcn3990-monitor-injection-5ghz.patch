From: rhodep port maintainers <rhodep@example.invalid>
Subject: [PATCH] ath10k: WCN3990 monitor mode + injection + 5 GHz unlock (rhodep port)

Full port of Loukious's hidden-STA-vdev injection technique to ath10k
mainline for WCN3990 devices (Motorola Moto G82 5G / sm6375). Adds:

  * WMI mgmt-forward hijack: monitor iface sees mgmt frames on WCN3990
    which does not support the classic PDEV promisc mode WMI cmd.
  * Hidden AP vdev (WMI_VDEV_TYPE_AP + VDEV_UP with self-BSSID) for TX.
    Aircrack-ng full suite works: aireplay -9 'Injection is working!',
    --deauth OTA, mdk4, scapy sendp, hcxdumptool.
  * Status normalization + retry-event drop in mgmt-tx-compl handler.
  * Atomic mgmt_pending_tx idr_remove + stale-entry GC + WMI HTC credit
    recovery. Prevents -108 ESHUTDOWN avalanche after fw drops a compl.
  * Chan-change throttle (rate-limit + fw-dead detect) + in-place
    vdev_restart on aireplay's channel-scan bursts.
  * 5 GHz TX/RX unlock via ath.country= module param on the parent
    ath common driver: permissive custom regdom that opens UNII-1/2/3
    without the NO_IR that ath_world_regdom_67_68_6A_6C hardcodes.
  * rhodep_inject_retune chanctx hook: keeps the hidden AP vdev on the
    same freq as the monitor vif so it does not pin the pdev radio to
    the wrong band after 2.4G<->5G channel changes.
  * Driver-side invalidate on ath10k_core_restart so fw recovery
    cleanly rebuilds the hidden vdev on next mgmt-tx.

See kernel/ath10k-rhodep-port/README.md for full architecture, wire
protocol notes, verified test evidence and known limitations.

Signed-off-by: rhodep port maintainers <rhodep@example.invalid>
---
diff -uprN pristine/drivers/net/wireless/ath/ath10k/core.c current/drivers/net/wireless/ath/ath10k/core.c
--- pristine/drivers/net/wireless/ath/ath10k/core.c	2026-09-07 02:05:11.015546004 +0000
+++ current/drivers/net/wireless/ath/ath10k/core.c	2026-09-07 02:05:11.015546004 +0000
@@ -2570,6 +2570,14 @@ static void ath10k_core_restart(struct w
 
 	reinit_completion(&ar->driver_recovery);
 
+	/* rhodep item 4: invalidate the hidden-STA injection vdev BEFORE
+	 * CRASH_FLUSH is set. Fw is about to reboot so its side is gone
+	 * anyway; this just clears our driver-side flag so the next
+	 * mgmt-tx worker iteration recreates the hidden vdev, instead of
+	 * dereferencing a stale vdev_id / getting -108 forever.
+	 */
+	ath10k_rhodep_inject_invalidate(ar);
+
 	set_bit(ATH10K_FLAG_CRASH_FLUSH, &ar->dev_flags);
 
 	/* Place a barrier to make sure the compiler doesn't reorder
@@ -3706,6 +3714,7 @@ struct ath10k *ath10k_core_create(size_t
 
 	mutex_init(&ar->conf_mutex);
 	mutex_init(&ar->dump_mutex);
+	spin_lock_init(&ar->rhodep_inject.lock);
 	spin_lock_init(&ar->data_lock);
 
 	for (int ac = 0; ac < IEEE80211_NUM_ACS; ac++)
diff -uprN pristine/drivers/net/wireless/ath/ath10k/core.h current/drivers/net/wireless/ath/ath10k/core.h
--- pristine/drivers/net/wireless/ath/ath10k/core.h	2026-09-07 02:05:11.013546004 +0000
+++ current/drivers/net/wireless/ath/ath10k/core.h	2026-09-07 02:05:11.013546004 +0000
@@ -1323,6 +1323,43 @@ struct ath10k {
 	s32 tx_power_2g_limit;
 	s32 tx_power_5g_limit;
 
+	/* rhodep: hidden STA vdev + self-peer created on-demand for
+	 * monitor-vif mgmt-tx injection. See mac.c ath10k_rhodep_ensure_inject_vdev.
+	 * Ported from Loukious v7 qcacld-3.0 monitor_sta_vdev_tx patch.
+	 */
+	struct {
+		bool created;
+		u8 vdev_id;         /* fw vdev id of the hidden helper */
+		u8 monitor_vdev_id; /* originating monitor vdev id */
+		u32 chanfreq;       /* frequency of the vdev_start */
+		u8 mac_addr[ETH_ALEN]; /* LAA MAC assigned to helper */
+		/* LRU cache of per-DA temp peers. Unused in the current AP
+		 * vdev design (self-peer is wildcard) but kept for backward
+		 * compat + potential future re-introduction with STA vdev.
+		 */
+#define ATH10K_RHODEP_PEER_CACHE 8
+		u8 peer_cache[ATH10K_RHODEP_PEER_CACHE][ETH_ALEN];
+		u8 peer_cache_next;
+		/* rhodep chan-change throttle + fw-dead detection. aireplay-ng
+		 * without -D hops 1..13 in ~20s. Without limiter each hop
+		 * would teardown+recreate the hidden AP vdev, saturating the
+		 * single WCN3990 HTC WMI credit and eventually tripping
+		 * ath10k_core_start_recovery -> CRASH_FLUSH -> -108 avalanche.
+		 * See wip-rhodep-loukious-hidden-sta/README.md for details.
+		 */
+		unsigned long last_chan_change; /* jiffies of last restart */
+		unsigned long last_fail;        /* jiffies of last -ESHUTDOWN */
+		u8 consec_fail;                 /* consecutive vdev-op fails */
+		/* SPINLOCK not mutex: gen_mgmt_tx_send is called from
+		 * ath10k_mgmt_over_wmi_tx_work via ath10k_wmi_cmd_send_nowait
+		 * which may hold spin_lock_bh(&ar->htc.tx_lock) or run in a
+		 * softirq path where mutex_lock would BUG_ON might_sleep.
+		 * Called from setup path (workqueue) via spin_lock_bh which
+		 * is safe.
+		 */
+		spinlock_t lock;
+	} rhodep_inject;
+
 	/* must be last */
 	u8 drv_priv[] __aligned(sizeof(void *));
 };
@@ -1337,6 +1374,7 @@ static inline bool ath10k_peer_stats_ena
 }
 
 extern unsigned int ath10k_frame_mode;
+extern unsigned int ath10k_mon_mgmt;
 extern unsigned long ath10k_coredump_mask;
 
 void ath10k_core_napi_sync_disable(struct ath10k *ar);
diff -uprN pristine/drivers/net/wireless/ath/ath10k/mac.c current/drivers/net/wireless/ath/ath10k/mac.c
--- pristine/drivers/net/wireless/ath/ath10k/mac.c	2026-09-07 02:05:11.010546003 +0000
+++ current/drivers/net/wireless/ath/ath10k/mac.c	2026-09-07 02:05:11.011546003 +0000
@@ -1544,6 +1544,13 @@ static int ath10k_vdev_start_restart(str
 		arg.ssid_len = arvif->vif->cfg.ssid_len;
 	}
 
+	if (ath10k_mon_mgmt)
+		ath10k_info(ar,
+			    "rhodep vdev-start id=%d type=%d freq=%d cf1=%d mode=%d restart=%d\n",
+			    arg.vdev_id, arvif->vdev_type, arg.channel.freq,
