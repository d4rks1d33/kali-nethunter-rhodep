+	/* The S3FWRN5 only lights its listen front-end when the routing table
+	 * carries the full five-entry set the vendor HAL programs (LMRT plen 27;
+	 * see docs/hal_ese_coexist.md). A trimmed three-entry table (plen 17)
+	 * is accepted with status 0x0 but never activates anything. Build the
+	 * five entries exactly, in the vendor order:
+	 *
+	 *   1) NFC-A technology  -> eSE  @ 0x3B
+	 *   2) MIFARE  (0x80)    -> eSE  @ 0x3B
+	 *   3) ISO-DEP (0x04)    -> eSE  @ 0x3B
+	 *   4) NFC-F technology  -> host @ 0x3F   (RF analog primer)
+	 *   5) NFC-DEP (0x05)    -> host @ 0x3F   (RF analog primer)
+	 *
+	 * Each entry's on-air value octets are, per NCI 2.0 and struct
+	 * nci_lmrt_{tech,proto}_entry: NFCEE-id, power-state, technology/proto.
+	 * (The RE notes list the two middle octets power-state-first; that is a
+	 * documentation ordering, not the wire order -- trust the struct.)
+	 */
+
+	/* 1) Route NFC-A technology. With a MIFARE-capable secure element,
+	 * route it there so the eSE owns the whole NFC-A layer -- the
+	 * anticollision with its own ATQA/SAK/UID from the provisioned card.
+	 * MIFARE Classic selection happens at the NFC-A technology level (it is
+	 * not an ISO-DEP protocol), so routing the technology to the eSE, not
+	 * just the MIFARE protocol, is what lets the eSE present the real card.
+	 * With emulate_host=1 nci_emu_ese_id() is 0, so this falls back to the
+	 * host and the same five-entry table tests host listen. */
 	tech = (struct nci_lmrt_tech_entry *)p;
 	tech->type = NCI_LMRT_TYPE_TECHNOLOGY;
 	tech->len = 3;
-	tech->nfcee_id = NCI_NFCEE_ID_HOST;
+	tech->nfcee_id = nci_emu_ese_id(ndev) ? : NCI_NFCEE_ID_HOST;
 	tech->power_state = NCI_LMRT_POWER_STATE_ALL;
