# hostapd-mana .config for the WiFi Pineapple port (karma + PineAPE Enterprise)
#
# Drop-in as hostapd/.config before `make`. Enables:
#   - nl80211 driver (the Archer USB adapter on wlan1 uses it)
#   - the full EAP SERVER (so the AP itself terminates EAP = evil twin, no RADIUS)
#   - WPE credential harvesting (folded into mana)
#   - the control interface (so hostapd_cli MANA_*/WPE_* work)
#
# Mirrors the capabilities the Hak5 wpad had (RE: PEAP/TTLS/TLS/FAST + MSCHAPv2
# + GTC + MD5 phase2, see /etc/pineape/hostapd-pineape.eap_user).

CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# --- control interface (hostapd_cli) ---------------------------------------
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_MIB=y

# --- AP features needed by karma -------------------------------------------
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_ACS=y

# --- EAP SERVER (PineAPE Enterprise: terminate EAP locally) ----------------
CONFIG_EAP=y
CONFIG_EAP_MD5=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_GTC=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_FAST=y
CONFIG_EAP_SIM=y
CONFIG_EAP_AKA=y
# Integrated EAP server (no external RADIUS; the AP is the auth server).
CONFIG_EAP_SERVER=y
CONFIG_RADIUS_SERVER=y

# --- IEEE 802.1X / WPA-Enterprise ------------------------------------------
CONFIG_IEEE8021X_EAPOL=y
CONFIG_INTERNAL_LIBTOMMATH=y

# --- TLS backend -----------------------------------------------------------
CONFIG_TLS=openssl

# --- WPE / MANA credential harvesting --------------------------------------
# hostapd-mana enables its MANA + WPE code paths unconditionally in src; this
# flag keeps the testing hooks the WPE callback uses available.
CONFIG_TESTING_OPTIONS=y

# --- misc ------------------------------------------------------------------
CONFIG_IPV6=y
CONFIG_WPS=y
