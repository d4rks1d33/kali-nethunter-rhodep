        { "image_path": "assets/keyboard.png" },
        { "text": "Second", "x": 40, "text_color_palette": "white" }
      ],
      "selected_layers": [
        { "image_path": "assets/keyboard.png" },
        { "text": "Second", "x": 40, "text_color_palette": "blue" }
      ],
      "button_map": {
        "a": "select",
        "b": "back",
        "up": "previous",
