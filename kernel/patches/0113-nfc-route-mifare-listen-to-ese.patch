-	 * raise RF_INTF_ACTIVATED_NTF to us, which is how we learn what the chip
-	 * actually comes up as when a reader is presented. */
+	/* 4) Route NFC-F technology to the host at all power states (0x3F).
+	 * This controller does not light its NFC-A listen front-end unless
+	 * NFC-F listen is also routed; this entry is what wakes the analog
+	 * front-end. The autonomous NFC-DEP/Type-3 peer that NFC-F would
+	 * otherwise present is neutralised in the emulation path via
+	 * LF_PROTOCOL_TYPE = 0, so this only powers the RF -- the NFC-A field
+	 * still reaches the eSE (or host) through entries 1-3. Always to the
+	 * host (0x00): it is an RF primer, not an offhost route. */
 	tech = (struct nci_lmrt_tech_entry *)p;
 	tech->type = NCI_LMRT_TYPE_TECHNOLOGY;
 	tech->len = 3;
 	tech->nfcee_id = NCI_NFCEE_ID_HOST;
-	tech->power_state = NCI_LMRT_POWER_STATE_ALL;
+	tech->power_state = NCI_LMRT_POWER_STATE_RF;
