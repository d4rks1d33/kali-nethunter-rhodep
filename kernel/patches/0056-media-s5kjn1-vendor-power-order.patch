From: rhodep port <none@example.com>
Date: Tue, 19 Aug 2026 19:40:00 -0300
Subject: [PATCH] media: s5kjn1: bring the rails up in the documented order

The driver enables vddd, then vdda, then vddio. The sensor's own
configuration data says the opposite: Qualcomm's sensormodule blob for
this module lists cam_vio, cam_vana, cam_vdig in that order, and the
vendor device tree repeats it.

The order matters because VDDIO feeds the I2C buffers. Powering the core
before its I/O supply can leave the part unable to answer on the bus, and
on a Motorola rhodep the difference is measurable: with the driver's
order, reads from the sensor address come back with a different value
every time; with this order they are stable.

This alone does not make the sensor identify itself on that board - it
ACKs but its chip id register still reads zero - but the ordering is what
the part documents and the instability it removes is real.

Signed-off-by: rhodep port <none@example.com>
---
--- a/drivers/media/i2c/s5kjn1.c
+++ b/drivers/media/i2c/s5kjn1.c
@@ -1205,30 +1205,32 @@
 	struct s5kjn1 *s5kjn1 = to_s5kjn1(sd);
 	int ret;
 
-	if (s5kjn1->vddd) {
-		ret = regulator_enable(s5kjn1->vddd);
+	/*
+	 * Bring the rails up in the order the sensor's own configuration data
+	 * specifies: VDDIO, then VDDA, then VDDD. VDDIO feeds the I2C buffers,
+	 * so powering the core first can leave the part unable to answer on the
+	 * bus. Qualcomm's blob for this module lists them as cam_vio, cam_vana,
+	 * cam_vdig, and the vendor device tree repeats that order.
+	 */
+	if (s5kjn1->vddio) {
+		ret = regulator_enable(s5kjn1->vddio);
 		if (ret)
 			return ret;
-
-		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+		usleep_range(2000, 3000);
 	}
 
 	if (s5kjn1->vdda) {
 		ret = regulator_enable(s5kjn1->vdda);
 		if (ret)
-			goto disable_vddd;
+			goto disable_vddio;
+		usleep_range(2000, 3000);
 	}
 
-	if (s5kjn1->vddio) {
-		ret = regulator_enable(s5kjn1->vddio);
+	if (s5kjn1->vddd) {
+		ret = regulator_enable(s5kjn1->vddd);
 		if (ret)
 			goto disable_vdda;
-	}
-
-	if (s5kjn1->afvdd) {
-		ret = regulator_enable(s5kjn1->afvdd);
-		if (ret)
-			goto disable_vddio;
+		usleep_range(2000, 3000);
 	}
 
 	ret = clk_prepare_enable(s5kjn1->mclk);
@@ -1244,19 +1246,14 @@
 	if (s5kjn1->afvdd)
 		regulator_disable(s5kjn1->afvdd);
 
-disable_vddio:
-	if (s5kjn1->vddio)
-		regulator_disable(s5kjn1->vddio);
-
+	if (s5kjn1->vddd)
+		regulator_disable(s5kjn1->vddd);
 disable_vdda:
 	if (s5kjn1->vdda)
 		regulator_disable(s5kjn1->vdda);
-
-disable_vddd:
-	if (s5kjn1->vddd) {
-		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
-		regulator_disable(s5kjn1->vddd);
-	}
+disable_vddio:
+	if (s5kjn1->vddio)
+		regulator_disable(s5kjn1->vddio);
 
 	return ret;
 }
