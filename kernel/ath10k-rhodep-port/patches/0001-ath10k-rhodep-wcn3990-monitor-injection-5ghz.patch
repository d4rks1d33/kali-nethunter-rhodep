+
 	ath10k_dbg(ar, ATH10K_DBG_MAC,
 		   "mac vdev %d start center_freq %d phymode %s\n",
 		   arg.vdev_id, arg.channel.freq,
@@ -1554,6 +1561,10 @@ static int ath10k_vdev_start_restart(str
 	else
 		ret = ath10k_wmi_vdev_start(ar, &arg);
 
+	if (ath10k_mon_mgmt)
+		ath10k_info(ar, "rhodep vdev-start id=%d wmi ret=%d\n",
+			    arg.vdev_id, ret);
+
 	if (ret) {
 		ath10k_warn(ar, "failed to start WMI vdev %i: %d\n",
 			    arg.vdev_id, ret);
@@ -1684,6 +1695,9 @@ static int ath10k_mac_setup_bcn_tmpl(str
 
 	ret = ath10k_wmi_bcn_tmpl(ar, arvif->vdev_id, offs.tim_offset, bcn, 0,
 				  0, NULL, 0);
+	if (ath10k_mon_mgmt)
