+
+		/* Keep the eSE powered and the NFCC<->eSE link up during listen
+		 * so the eSE can answer the reader's NFC-A field even in low /
+		 * off power states (matches the vendor OFFHOST_AID_ROUTE_PWR_STATE
+		 * = 0x3B / DEFAULT_ROUTE = 0x83 intent). NCI 2.0
+		 * NFCEE_POWER_AND_LINK_CTRL, GID 0x2 OID 0x3 -> on the wire:
+		 * 20 03 02 83 03. Sent only on the eSE path, after the eSE is
+		 * (already) enabled and before the LMRT. Fire-and-forget: if the
+		 * controller does not support it the RSP is a non-OK status which
+		 * is harmless here -- MIFARE routing is a pure LMRT operation and
+		 * does not depend on this command. */
+		if (nci_emu_ese_id(ndev)) {
+			struct nci_nfcee_power_and_link_ctrl_cmd plc;
+
+			plc.nfcee_id = nci_emu_ese_id(ndev);
+			plc.pli = NCI_NFCEE_PWR_LINK_ALWAYS_ON;
+			nci_send_cmd(ndev,
+				     NCI_OP_NFCEE_POWER_AND_LINK_CTRL_CMD,
+				     sizeof(plc), &plc);
+		}
