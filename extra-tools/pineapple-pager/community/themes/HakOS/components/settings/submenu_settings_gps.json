{
  "screen_name": "settings_gps_submenu",
  "status_bar": "gps",
  "windowed_canvas": false,
  "cache_canvases": false,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "noop",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/settings_bg.png", "x": 0, "y": 0 }
    ]
  },
  "pages": [
    {
      "page_index": 0,
      "menu_items": [
        {
          "id": "Port",
          "x":10,
          "y":50,
          "unselectable": true,
          "layers": [
            { "x":0, "text": "Lat:", "text_size": "medium", "text_color": "medium_gray"},
            { "variable_name": "$_GPS_LAT", "x": 60, "string_template": {"text_size": "medium", "text_color_palette": "gray" } },
            { "x":160, "text": "Lon:", "text_size": "medium", "text_color": "medium_gray"},
            { "variable_name": "$_GPS_LON", "x": 220, "string_template": {"text_size": "medium", "text_color_palette": "gray" }}
          ]
        },
        {
          "id": "Port",
          "x":10,
          "y":85,
          "layers": [
            { "image_path": "assets/menu.png" },
            { "text": "Serial Device", "x": 40, "text_color_palette": "white" }
          ],
          "selected_layers": [
            { "image_path": "assets/menu.png" },
            { "text": "Serial Device", "x": 40, "text_color_palette": "blue" }
          ],
          "target": "option_dialog",
          "variable": "$_GPS_DEVICE"
        },
        {
          "id": "Baud Rate",
          "x":10,
          "y":120,
          "layers": [
            { "image_path": "assets/menu.png" },
            { "text": "Baud Rate", "x": 40, "text_color_palette": "white" }
          ],
          "selected_layers": [
            { "image_path": "assets/menu.png" },
            { "text": "Baud Rate", "x": 40, "text_color_palette": "blue" }
          ],
          "target": "option_dialog",
          "variable": "$_GPS_BAUD"
        },
        {
          "id": "restart",
          "x":10,
          "y":155,
          "layers": [
            { "image_path": "assets/start.png", "x": 4, "y": 1, "recolor_palette": "white" },
            { "text": "Restart GPSd", "x": 40,  "text_color_palette": "white" }
          ],
          "selected_layers": [
            { "image_path": "assets/start.png", "x": 4, "y": 1, "recolor_palette": "red" },
            { "text": "Restart GPSd", "x": 40, "text_color_palette": "red" }
          ],
          "target": "function_restart_gpsd"
        }
      ]
    }
  ]

}

















































