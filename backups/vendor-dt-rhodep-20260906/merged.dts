			compatible = "qcom,msm-watchdog";
			reg = <0xf410000 0x1000>;
			reg-names = "wdt-base";
			interrupts = <0x00 0x00 0x04 0x00 0x01 0x04>;
			qcom,bark-time = <0x2af8>;
			qcom,pet-time = <0x2490>;
			qcom,ipi-ping;
			qcom,wakeup-enable;
			phandle = <0x1f0>;
		};

