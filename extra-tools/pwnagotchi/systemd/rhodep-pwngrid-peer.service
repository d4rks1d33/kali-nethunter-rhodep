[Unit]
Description=pwngrid peer for pwnagotchi (rhodep, radio via RHODEP_PWN_RADIO)
Documentation=https://pwnagotchi.org
Wants=network.target
Requires=rhodep-pwn-bettercap.service
After=rhodep-pwn-bettercap.service

[Service]
Type=simple
# The launcher waits for the monitor iface the bettercap service brought up
# (wlan1mon for external, mon0 for internal) and execs pwngrid on it.
Environment=RHODEP_PWN_RADIO=external
ExecStart=/usr/local/sbin/rhodep-pwn-pwngrid-launcher
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
