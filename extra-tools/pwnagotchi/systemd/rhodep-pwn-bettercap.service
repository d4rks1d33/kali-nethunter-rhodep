[Unit]
Description=bettercap for pwnagotchi (rhodep, radio selected by RHODEP_PWN_RADIO)
Documentation=https://bettercap.org
Wants=network.target
After=network.target

[Service]
Type=simple
# Radio is chosen by RHODEP_PWN_RADIO=external|internal, set via a drop-in
# (e.g. /etc/systemd/system/rhodep-pwn-bettercap.service.d/20-radio.conf). The
# launcher and monstop-dispatch both read the same env var so they stay in
# sync. Default (no drop-in) = external wlan1 path, the shipped setup.
Environment=RHODEP_PWN_RADIO=external
ExecStart=/usr/local/sbin/rhodep-pwn-bettercap-launcher
# Dispatch to the right monstop for whichever radio start-side selected.
# monstop keeps its wlan1-only guarantees; monstop-internal touches wlan0 only.
ExecStopPost=/usr/local/sbin/rhodep-pwn-monstop-dispatch
Restart=always
RestartSec=15
LimitNOFILE=65535
StandardOutput=append:/etc/pwnagotchi/log/bettercap.log
StandardError=append:/etc/pwnagotchi/log/bettercap.log

[Install]
WantedBy=multi-user.target
