[Unit]
Description=Build the external USB Wi-Fi drivers (rtw88 / rtl8188eus) against the running kernel
Documentation=file:/usr/local/share/rhodep/wifi-drivers
# Needs the network the first time, to apt-install realtek-rtl8188eus-dkms and
# the build deps. Stays ENABLED across boots: the builder stamps success against
# a fingerprint of the running kernel build (uname -r + uname -v), so it is a
# cheap no-op on an ordinary boot but rebuilds the drivers automatically after a
# kernel change -- including a rebuild of the SAME version, where uname -r is
# unchanged but the modules are new.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rhodep-wifi-drivers-build
# The builder keys success to the kernel-build fingerprint and re-verifies that
# the driver actually loads, so it does the right thing whether the kernel is
# unchanged, rebuilt, or bumped. exit 0 on transient failure (no network, no
# headers yet) so a failed attempt just retries next boot instead of being
# marked failed.
RemainAfterExit=no
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
