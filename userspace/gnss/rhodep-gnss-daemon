# How consumers turn an HDOP into an accuracy in metres, measured against
# geoclue 2.8.1 on this phone by feeding it synthetic GGA at fixed HDOP:
#
#     HDOP  <= 1   ->    0 m      "ideal"
#           <= 2   ->    1 m      "excellent"
#           <= 5   ->    3 m      "good"
#           <= 10  ->   50 m      "moderate"
#           <= 20  ->  100 m      "fair"
#            > 20  ->  300 m      "poor"
#
# which is the textbook DOP quality rating scale. It matters because HDOP is
# the only quality figure GGA can carry, and a WiFi fix has no satellite
# geometry, so whatever we put there is a fabrication either way. The question
# is only which fabrication is honest.
#
# Scaling accuracy by some metres-per-DOP constant is the obvious choice and it
# is the wrong one: a 22 m WiFi fix at the conventional 5 m/DOP gives HDOP 4.4,
# which lands in the "good" band and makes geoclue report 3 m. Claiming 3 m for
# a 22 m fix is a seven-fold overstatement that nothing downstream can catch.
#
# So instead: pick the lowest band whose representative accuracy is still at
# least as large as the accuracy we were actually given, and emit an HDOP from
# inside it. Consumers that bucket HDOP then round our error *up*, never down.
# Consumers that read $GPGST -- gpsd does -- get the exact metres regardless.
DOP_BANDS = (
    # (upper HDOP of the band, accuracy such a band implies, HDOP to emit)
    (1.0, 0.0, 1.0),
    (2.0, 1.0, 1.5),
    (5.0, 3.0, 3.5),
    (10.0, 50.0, 7.5),
    (20.0, 100.0, 15.0),
    (float("inf"), 300.0, 25.0),
)


def dop_for_accuracy(accuracy):
    """HDOP to advertise for a fix known to be `accuracy` metres.

    Never one that would let a consumer infer a smaller error than the truth.
    """
    for _upper, implied, emit in DOP_BANDS:
        if implied >= accuracy:
            return emit
    return DOP_BANDS[-1][2]


# The coarsest error the HDOP channel can express at all: geoclue's mapping
# saturates, so every fix worse than this reads as exactly this to geoclue.
#
#     gclue_location_get_accuracy_from_hdop(): ... return 300;
#
# That saturation is the honesty problem with cell-tower positioning. A WiFi
# fix here is 20-30 m and lands in a band comfortably. A cell-tower fix is
# typically 250-3000 m, and everything from 301 m upwards would be published to
# geoclue as "300 m" -- a claim the daemon knows to be false at the moment it
# makes it, and one no consumer can check, because HDOP is not an error
# estimate and there is no other field in $GPGGA that is.
#
# $GPGST does carry real metres and gpsd does read it, so gpsd clients are told
# the truth regardless. geoclue 2.8.1 does not: `strings /usr/libexec/geoclue`
# on this phone contains "$GPGGA" and nothing else, and gclue-nmea-source.c
# only ever parses GGA. So there is no encoding that reaches geoclue with a
# number above 300.
#
# Given that, the choice is between publishing a fix geoclue will
# under-estimate and publishing no fix. This daemon publishes no fix, by
# default, and says why in the log. --max-nmea-accuracy relaxes it for anyone
# who would rather have a coarse position than none; the GST metres stay honest
# either way.
HDOP_CEILING_ACCURACY = DOP_BANDS[-1][1]


def hdop_reported_accuracy(accuracy):
    """What a consumer bucketing our HDOP will conclude the accuracy is."""
    emit = dop_for_accuracy(accuracy)
    for _upper, implied, e in DOP_BANDS:
        if e == emit:
            return implied
    return DOP_BANDS[-1][1]


