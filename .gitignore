# Built artifacts (regenerate with the scripts / pmbootstrap)
*.deb
*.img
*.apk
*.tar.gz
*.tar.xz
*.sqfs
*.bmap

# Vendor firmware blobs (NOT redistributable)
packages/firmware-motorola-rhodep/lib/firmware/**
!packages/firmware-motorola-rhodep/lib/firmware/.gitkeep

# Local firmware backups kept on disk but NOT pushed (blobs, not redistributable).
# Track the folder structure, notes, and small text/RE helpers; ignore the big
# non-redistributable binaries (firmware .mbn, built .ko, raw source copies).
backups/**/*.mbn
backups/**/*.mbn.*
backups/**/*.bin
backups/**/*.ko
backups/**/*.ko.*
backups/**/*.c.wip
backups/**/*.img
backups/**/*.elf

# debos build output
debos/rootfs*.tar.xz

# ...but DO include the documentation screenshots
!docs/screenshots/
!docs/screenshots/*.png
!docs/screenshots/*.jpg
__pycache__/
