{
  "screen_name": "launch_payload_dialog",
  "status_bar": "default",
  "windowed_canvas": true,
  "cache_canvases": true,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "back",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/edit_string_dialog_bg.png", "x": 0, "y": 0 },
      { "variable_name": "$_PAYLOAD_TITLE", "x":  30, "y": 40, "string_template": {"text_color_palette": "white", "text_size": "medium", "max_chars": 22, "wrap_text": false, "max_lines": 1 }},
      { "text": "Author:", "x": 30, "y": 70,  "text_size": "small" },
      { "variable_name": "$_PAYLOAD_AUTHOR_NAME", "x":  95, "y": 70, "string_template": {"text_size": "small", "max_chars": 24, "wrap_text": false, "max_lines": 1 }},      
      { "x": 150, "y": 85, "variable_name": "$_PAYLOAD_DESCRIPTION", "string_template": {"max_chars": 50, "wrap_text": true, "max_lines": 8, "text_size": "small", "text_color_palette": "disabled_light_gray", "center_text_within": { "draw_bounds": false, "start_x": 18, "end_x": 460, "start_y": 85, "end_y": 170 }}}
    ]
  },
  "menu_items": [
    {
      "id": "Launch",
      "layers": [
        { "image_path":  "assets/confirmation_dialog/generic_confirmation_button_deselected.png", "x": 160, "y": 177 },
        { "text": "Launch", "x": 161, "y": 177, "text_size": "medium", "text_color_palette": "white" }
      ],
      "selected_layers": [
        { "image_path":  "assets/confirmation_dialog/generic_confirmation_button_selected.png", "x": 160, "y": 177 },
        { "text": "Launch", "x": 161, "y": 177, "text_size": "medium", "text_color_palette": "disabled_dark_gray" }
      ],
      "target": "launch_payload",
      "variable": "$_INPUT",
      "animation": [
        { "image_path": "assets/launch_payload_dialog/animation/anim_frame_1.png","x": 420, "y": 35 },
        { "image_path": "assets/launch_payload_dialog/animation/anim_frame_1.png","x": 420, "y": 35 },
        { "image_path": "assets/launch_payload_dialog/animation/anim_frame_2.png","x": 420, "y": 35 }
      ]
    },
    {
      "id": "Cancel",
      "layers": [
        { "image_path":  "assets/confirmation_dialog/generic_confirmation_button_deselected.png", "x": 252, "y": 177 },
        { "text": "Cancel", "x": 254, "y": 177, "text_size": "medium", "text_color_palette": "white" }
      ],
      "selected_layers": [
        { "image_path":  "assets/confirmation_dialog/generic_confirmation_button_selected.png", "x": 252, "y": 177 },
        { "text": "Cancel", "x": 254, "y": 177, "text_size": "medium", "text_color_palette": "disabled_dark_gray" }
      ],
      "target": "back"
    }
  ]
}
