      ],
      "button_map": {
        "a": "select",
        "b": "back",
        "up": "previous",
        "down": "next",
        "left": "goto Year",
        "right": "noop"
      },
      "target": "edit_number_dialog",
      "variable": "$_MINUTE"
    },
    {
      "id": "Second",
