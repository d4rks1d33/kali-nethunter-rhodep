# Built artifacts (regenerate with the scripts / pmbootstrap)
*.deb
*.img
*.apk
*.tar.gz
*.tar.xz
*.sqfs
*.bmap

# Vendor firmware blobs (NOT redistributable)
packages/firmware-motorola-rhodep/lib/firmware/**
!packages/firmware-motorola-rhodep/lib/firmware/.gitkeep

# Local backups kept on disk but NOT pushed. Track the folder structure, notes,
# and small text/RE helpers; ignore blobs and any snapshots of source that is
# already versioned elsewhere in the repo (avoid duplicating files that already
# live under kernel/, userspace/, extra-tools/, etc.).
backups/**/*.mbn
backups/**/*.mbn.*
backups/**/*.bin
backups/**/*.ko
backups/**/*.ko.*
backups/**/*.c.wip
backups/**/*.img
backups/**/*.elf
# repo snapshots inside backups/*/repo/ are duplicates of tracked source
backups/**/repo/**
# systemd/config snapshots that shadow tracked files
backups/**/*.service
backups/**/*.toml
backups/**/*.toml.*
# device tarballs (uname, config, /etc snapshots)
backups/**/*.tar.gz
backups/**/*.tar.xz

# debos build output
debos/rootfs*.tar.xz

# ...but DO include the documentation screenshots
!docs/screenshots/
!docs/screenshots/*.png
!docs/screenshots/*.jpg
__pycache__/
