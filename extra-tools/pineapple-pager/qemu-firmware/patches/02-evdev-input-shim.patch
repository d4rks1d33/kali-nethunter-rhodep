+/* ===================== PINEAPPLE PAGER INPUT SHIM =====================
+ * The firmware (go-evdev) opens every /dev/input/eventN with O_RDWR, sets it
+ * O_NONBLOCK, registers it with epoll and read()s 16-byte struct input_event
+ * records. The rootfs event nodes are fake regular files (read -> EINVAL) and
+ * the host kernel has NO uinput (CONFIG_INPUT_UINPUT unset), so we cannot make
+ * a real evdev device.
+ *
+ * Instead, for every guest open of /dev/input/eventN we create a socketpair
+ * (AF_UNIX): the guest gets one end (behaves like a real pollable char dev,
+ * works with epoll + O_NONBLOCK), qemu keeps the other end. A background
+ * thread reads injected events from a host FIFO (PAGER_INPUT_FIFO, default
+ * /tmp/pager_input.fifo) and BROADCASTS each 16-byte record to ALL the qemu
+ * side ends, so whichever eventN the firmware actually listens on receives it.
+ * Records are raw struct input_event in target (==host little-endian) order:
+ *   __u32 sec; __u32 usec; __u16 type; __u16 code; __s32 value;  (16 bytes)
+ * ===================================================================== */
+#include <pthread.h>
+#define PAGER_MAX_INPUT 16
+static int  pager_input_host[PAGER_MAX_INPUT]; /* qemu-side socketpair ends  */
+static int  pager_input_n = 0;
+static pthread_mutex_t pager_input_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t pager_input_thr;
+static int  pager_input_started = 0;
+
+static const char *pager_input_fifo_path(void) {
+    const char *p = getenv("PAGER_INPUT_FIFO");
+    return (p && *p) ? p : "/tmp/pager_input.fifo";
+}
+
+static void pager_input_broadcast(const unsigned char *rec, int len) {
+    int i;
+    pthread_mutex_lock(&pager_input_lock);
+    if (getenv("PAGER_DBG")) {
+        FILE *dl = fopen("/tmp/pager_shim_dbg.log","a");
+        if (dl){fprintf(dl,"broadcast to %d fds type=%u code=%u val=%d\n",
+            pager_input_n,(unsigned)(rec[8]|(rec[9]<<8)),
+            (unsigned)(rec[10]|(rec[11]<<8)),
+            (int)(rec[12]|(rec[13]<<8)|(rec[14]<<16)|(rec[15]<<24)));fclose(dl);}
+    }
+    int only = getenv("PAGER_INPUT_ONE") ? 1 : pager_input_n;
+    for (i = 0; i < only; i++) {
+        int fd = pager_input_host[i];
+        if (fd >= 0) {
+            ssize_t w = write(fd, rec, len);
+            if (getenv("PAGER_DBG") && w != len) {
+                FILE*dl=fopen("/tmp/pager_shim_dbg.log","a");
+                if(dl){fprintf(dl,"WRITE_FAIL fd=%d w=%zd errno=%d\n",fd,w,errno);fclose(dl);}
+            }
+        }
+    }
+    pthread_mutex_unlock(&pager_input_lock);
+}
+
+static void *pager_input_reader(void *arg) {
+    const char *path = pager_input_fifo_path();
+    (void)arg;
+    if (getenv("PAGER_DBG")) { FILE*d=fopen("/tmp/pager_shim_dbg.log","a");
+        if(d){fprintf(d,"THREAD_DBG reader started path=%s\n",path);fclose(d);} }
+    for (;;) {
+        /* O_RDWR so the FIFO always has a writer and read() blocks instead of
+         * spinning on EOF when no injector is connected. */
+        int ff = open(path, O_RDWR);
+        if (getenv("PAGER_DBG")) { FILE*d=fopen("/tmp/pager_shim_dbg.log","a");
+            if(d){fprintf(d,"THREAD_DBG open(%s,O_RDWR)=%d errno=%d\n",path,ff,errno);fclose(d);} }
+        if (ff < 0) { sleep(1); continue; }
+        for (;;) {
+            unsigned char rec[16];
+            ssize_t n = read(ff, rec, sizeof(rec));
+            if (n == 16) {
+                pager_input_broadcast(rec, 16);
+            } else if (n <= 0) {
+                break; /* reopen */
+            }
+            /* ignore partial reads (<16): FIFO writes are atomic for <=PIPE_BUF */
+        }
+        close(ff);
+    }
+    return NULL;
+}
+
+static void pager_input_start(void) {
+    int rc;
+    if (pager_input_started) return;
+    pager_input_started = 1;
+    if (getenv("PAGER_DBG")) { FILE*d=fopen("/tmp/pager_shim_dbg.log","a");
+        if(d){fprintf(d,"THREAD_DBG before pthread_create\n");fclose(d);} }
+    rc = pthread_create(&pager_input_thr, NULL, pager_input_reader, NULL);
+    if (getenv("PAGER_DBG")) { FILE*d=fopen("/tmp/pager_shim_dbg.log","a");
+        if(d){fprintf(d,"THREAD_DBG pthread_create rc=%d\n",rc);fclose(d);} }
+}
+
+/* Create a socketpair for a newly opened guest /dev/input/eventN. Returns the
+ * guest-side fd, or -1 to fall through to the normal open path. */
+static int pager_open_input(const char *fname) {
+    const char *base;
+    int sp[2];
+    if (!fname) return -1;
+    base = strstr(fname, "/input/event");
+    if (!base) return -1;
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, sp) < 0) return -1;
+    { int fl = fcntl(sp[1], F_GETFL, 0); if (fl>=0) fcntl(sp[1], F_SETFL, fl|O_NONBLOCK); }
+    pthread_mutex_lock(&pager_input_lock);
+    if (pager_input_n < PAGER_MAX_INPUT) {
+        pager_input_host[pager_input_n++] = sp[1];
+        if (getenv("PAGER_DBG")) {
+            FILE *dl = fopen("/tmp/pager_shim_dbg.log","a");
+            if (dl){fprintf(dl,"open input %s -> guest_fd=%d host_fd=%d n=%d\n",
+                fname, sp[0], sp[1], pager_input_n);fclose(dl);}
+        }
+    } else {
+        close(sp[1]); /* too many; drop the qemu side, guest end still valid */
+    }
+    pthread_mutex_unlock(&pager_input_lock);
+    pager_input_start();
+    return sp[0];
+}
