/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Blair ";
	compatible = "qcom,blair";
	qcom,msm-id = <0x1fb 0x10000 0x242 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;
	channel-id-map = [00];

	chosen {
		bootargs = "log_buf_len=256K rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off";
		phandle = <0x1d9>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x1da>;

		mmi_annotate_mem_region {
			phandle = <0x3d9>;
			reg = <0x00 0xaefa1800 0x00 0x800>;
			no-map;
		};

		tzlog_dump_mem_region {
			phandle = <0x44c>;
			reg = <0x00 0xaefa2000 0x00 0x30000>;
			no-map;
		};

		wdog_cpuctx_region {
			phandle = <0x44b>;
			reg = <0x00 0xaefd2000 0x00 0x2e000>;
			no-map;
		};

		ramoops_mem {
			no-dump-oops;
			record-size = <0x3f800>;
			pmsg-size = <0x40000>;
			console-size = <0x40000>;
			reg = <0x00 0xaf000000 0x00 0xbf800>;
			no-map;
			compatible = "ramoops";
		};

		hyp@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x1db>;
		};

		xbl_aop_mem@80700000 {
			no-map;
			reg = <0x00 0x80700000 0x00 0x100000>;
			phandle = <0x1dc>;
		};

		reserved_xbl_uefi@80880000 {
			no-map;
			reg = <0x00 0x80880000 0x00 0x14000>;
			phandle = <0x1dd>;
		};

		smem@80900000 {
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0x7a>;
		};

		fw_mem@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
			phandle = <0x1de>;
		};

		wlan@86500000 {
			no-map;
			reg = <0x00 0x86500000 0x00 0x200000>;
			phandle = <0x1cd>;
		};

		adsp@86700000 {
			no-map;
			reg = <0x00 0x86700000 0x00 0x2000000>;
			phandle = <0x8d>;
		};

		cdsp@88700000 {
			no-map;
			reg = <0x00 0x88700000 0x00 0x1e00000>;
			phandle = <0x90>;
		};

		video@8a500000 {
			no-map;
			reg = <0x00 0x8a500000 0x00 0x500000>;
			phandle = <0x84>;
		};

		ipa_fw@8aa00000 {
			no-map;
			reg = <0x00 0x8aa00000 0x00 0x10000>;
			phandle = <0x97>;
		};

		ipa_gsi@8aa10000 {
			no-map;
			reg = <0x00 0x8aa10000 0x00 0xa000>;
			phandle = <0x1df>;
		};

		gpu_micro_code@8aa1a000 {
			no-map;
			reg = <0x00 0x8aa1a000 0x00 0x2000>;
			phandle = <0x9f>;
		};

		mpss_wlan@8b800000 {
			no-map;
			reg = <0x00 0x8b800000 0x00 0x10000000>;
			phandle = <0x93>;
		};

		removed_region@c0000000 {
			no-map;
			reg = <0x00 0xc0000000 0x00 0x7100000>;
			phandle = <0x1e0>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0xaa>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x800000>;
			phandle = <0x55>;
		};

		splash_region@0x85200000 {
			reg = <0x00 0x85200000 0x00 0xc00000>;
			label = "cont_splash_region";
			phandle = <0x1e1>;
		};

		dfps_data_region@85e00000 {
			reg = <0x00 0x85e00000 0x00 0x100000>;
			label = "dfps_data_region";
			phandle = <0x16b>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0x86>;
		};

		user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0xab>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			phandle = <0x96>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x3000000>;
			phandle = <0xac>;
		};

		memshare_region {
			compatible = "shared-dma-pool";
			no-map;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			alignment = <0x00 0x100000>;
			size = <0x00 0x800000>;
			phandle = <0x61>;
		};
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
	};

	aliases {
		ufshc1 = "/soc/ufshc@4804000";
		sdhc0 = "/soc/sdhci@4744000";
		sdhc1 = "/soc/sdhci@4784000";
		serial0 = "/soc/qcom,qup_uart@4c8c000";
		hsuart0 = "/soc/qcom,qup_uart@4a84000";
		swr0 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/va-macro@A730000/va_swr_master";
		swr1 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/rx-macro@A600000/rx_swr_master";
		phandle = <0x1e2>;
	};

	firmware {
		phandle = <0x1e3>;

		scm {
			compatible = "qcom,scm";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x10>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x04>;

				l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x06>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x07>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x11>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x08>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x12>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x08>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x13>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0a>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x14>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0a>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			cpu-idle-states = <0x02 0x03>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0b>;
			qcom,freq-domain = <0x05 0x00 0x06>;
			phandle = <0x15>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			cpu-idle-states = <0x0c 0x0d>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0e>;
			qcom,freq-domain = <0x05 0x01 0x02>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0e>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			cpu-idle-states = <0x0c 0x0d>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			cpu-release-addr = <0x00 0x50000000>;
			next-level-cache = <0x0f>;
			qcom,freq-domain = <0x05 0x01 0x02>;
			phandle = <0x17>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x06>;
				phandle = <0x0f>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				core2 {
					cpu = <0x12>;
				};

				core3 {
					cpu = <0x13>;
				};

				core4 {
					cpu = <0x14>;
				};

				core5 {
					cpu = <0x15>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x16>;
				};

				core1 {
					cpu = <0x17>;
				};
			};
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		#gpio-cells = <0x02>;
		compatible = "simple-bus";
		phandle = <0x1e4>;

		ldo_vib {
			status = "ok";
			moto,vib-ldo-gpio = <0x8a 0x64 0x00>;
			compatible = "moto,vibrator-ldo";
		};

		gpio_keys {
			pinctrl-0 = <0x44a>;
			pinctrl-names = "default";
			label = "gpio-keys";
			compatible = "gpio-keys";

			vol_up {
				linux,can-disable;
				debounce-interval = <0x0f>;
				gpio-key,wakeup;
				linux,code = <0x73>;
				linux,input-type = <0x01>;
				gpios = <0x3fa 0x01 0x01>;
				label = "volume_up";
			};
		};

		sys_temp_support {
			phandle = <0x498>;
			status = "ok";
			mmi,temperature-names = "front_temp\0back_temp";
			compatible = "mmi,sys-temp";
		};

		rt-pd-manager {
			phandle = <0x443>;
			io-channel-names = "usb_real_type\0otg_enable\0typec_mode\0pd_active\0mmi_pd_vdm_verify";
			io-channels = <0x441 0x0a 0x441 0x105 0x441 0x01 0x441 0x04 0x441 0x117>;
			#io-channel-cells = <0x01>;
			compatible = "richtek,rt-pd-manager";
		};

		mmi_chrg_manager {
			phandle = <0x497>;
			mmi,thermal-mitigation = <0x588040 0x4c4b40 0x3d0900 0x3567e0 0x2dc6c0 0x1e8480 0xf4240>;
			mmi,mmi-chrg-temp-zones = <0x00 0x1068 0x3e8 0x00 0x00 0x0a 0x109a 0xbb8 0x1162 0x3e8 0x0f 0x1162 0xbb8 0x00 0x00 0x2d 0x10fe 0x16a8 0x1180 0xfa0 0x3c 0x1068 0xfa0 0x00 0x00>;
			mmi,chrg-temp-zones-num = <0x05>;
			mmi,qc3p-volt-max = <0x989680>;
			mmi,qc3p-volt-steps = <0x4e20>;
			mmi,qc3p-max-ibus-ma = <0xb54>;
			mmi,dont-rerun-aicl;
			mmi,step-first-current-comp = <0x00>;
			mmi,pd-allow-min-current = <0xf4240>;
			mmi,typec-middle-current = <0x1e8480>;
			mmi,batt-ovp-lmt = <0x456d70>;
			mmi,batt-curr-boost = <0x493e0>;
			mmi,pd-curr-max = <0x2dc6c0>;
			mmi,pd-volt-max = <0x989680>;
			mmi,pps-curr-steps = <0x186a0>;
			mmi,pps-volt-steps = <0x4e20>;
			io-channel-names = "hw_current_max\0charging_enabled\0typec_mode\0input_current_settled\0pd_active\0termination_enabled\0usb_real_type\0battery_dp_dm\0usb_qc3p_power\0cp_enabled\0cp_input_current_now\0cp_input_voltage_settled\0cp_status1\0cp_clear_error";
			io-channels = <0x441 0x09 0x441 0x10f 0x441 0x01 0x441 0x10a 0x441 0x04 0x441 0x113 0x441 0x0a 0x441 0x3e 0x441 0x104 0x442 0x67 0x442 0x100 0x442 0x101 0x442 0x65 0x442 0x109>;
			#io-channel-cells = <0x01>;
			compatible = "mmi,chrg-manager";

			charger_device_1 {
				charging-curr-min = <0x16e360>;
				psy-name = "cp-standalone";
				chrg-name = "cp-master";
			};

			charger_device_0 {
				charging-curr-limited = <0x493e0>;
				psy-name = "battery";
				chrg-name = "pmic-sw";
			};
		};

		mmi,discrete-charging {
			phandle = <0x441>;
			mmi,thermal-mitigation = <0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0x124f80 0xdbba0 0x927c0 0x493e0>;
			mmi,mmi-temp-zones = <0x00 0x1068 0x3e8 0x00 0x0a 0x109a 0xbb8 0x3e8 0x0f 0x00 0xbb8 0xbb8 0x2d 0x00 0xfa0 0xfa0 0x3c 0x1068 0xbb8 0x00>;
			mmi,df-serialnum = "SB18D33989";
			mmi,otg-cl-ua = <0x124f80>;
			mmi,demo-fv-mv = <0xfa0>;
			mmi,max-fcc-ma = <0xbb8>;
			mmi,max-fv-mv = <0x1162>;
			mmi,fg-iterm-ma = <0x1f4>;
			mmi,chrg-iterm-ma = <0xf3>;
			supplied-from = "mmi_battery";
			battery-names = "battery";
			#io-channel-cells = <0x01>;
			compatible = "mmi,mmi-discrete-charger";
			status = "ok";
		};

		mmi,charger {
			phandle = <0x496>;
			mmi,hvdcp-power-max = <0x3a98>;
			mmi,dcp-power-max = <0x2710>;
			mmi,heartbeat-interval = <0x1388>;
			mmi,lower-limit-capacity = <0x3c>;
			mmi,upper-limit-capacity = <0x41>;
			mmi,enable-charging-limit;
			compatible = "mmi,mmi-charger";
			status = "ok";
		};

		gpio-regulator@0 {
			phandle = <0x41b>;
			pinctrl-0 = <0x418>;
			pinctrl-names = "default";
			gpio = <0x8a 0x56 0x00>;
			enable-active-high;
			regulator-enable-ramp-delay = <0xe9>;
			regulator-max-microvolt = <0x2ab980>;
			regulator-min-microvolt = <0x2ab980>;
			regulator-name = "cam_ois_ldo";
			reg = <0x00 0x00>;
			compatible = "regulator-fixed";
		};

		qcom,cam-res-mgr {
			pinctrl-1 = <0x417>;
			pinctrl-0 = <0x416>;
			pinctrl-names = "flash_active\0flash_suspend";
			gpios-shared = <0x194>;
			status = "ok";
			compatible = "qcom,cam-res-mgr";
		};

		pm6125_flash_gpio {
			phandle = <0x48d>;
			pwms = <0x415 0x00 0x00>;
			pinctrl-0 = <0x414>;
			pinctrl-names = "camera_flash_pwm_default";
			compatible = "qualcomm,pm6125_flash_gpio";
		};

		panel_gpio_regulator@1 {
			phandle = <0x3fd>;
			pinctrl-0 = <0x40e>;
			pinctrl-names = "default";
			proxy-supply = <0x3fd>;
			regulator-boot-on;
			enable-active-high;
			gpio = <0x8a 0x2e 0x00>;
			regulator-enable-ramp-delay = <0xe9>;
			regulator-max-microvolt = <0x2dc6c0>;
			regulator-min-microvolt = <0x2dc6c0>;
			regulator-name = "panel_vci";
			compatible = "qti-regulator-fixed";
		};

		dsi_panel_pwr_supply_amoled {
			phandle = <0x40d>;
			#size-cells = <0x00>;
			#address-cells = <0x01>;

			qcom,panel-supply-entry@2 {
				qcom,supply-post-off-sleep = <0x02>;
				qcom,supply-post-on-sleep = <0x00>;
				qcom,supply-disable-load = <0x00>;
				qcom,supply-enable-load = <0x7530>;
				qcom,supply-max-voltage = <0x2dc6c0>;
				qcom,supply-min-voltage = <0x2dc6c0>;
				qcom,supply-name = "vci";
				reg = <0x02>;
			};

			qcom,panel-supply-entry@1 {
				qcom,supply-post-off-sleep = <0x02>;
				qcom,supply-post-on-sleep = <0x02>;
				qcom,supply-disable-load = <0x0a>;
				qcom,supply-enable-load = <0xed1c>;
				qcom,supply-max-voltage = <0x1312d0>;
				qcom,supply-min-voltage = <0x1312d0>;
				qcom,supply-name = "dvdd";
				reg = <0x01>;
			};

