# --------------------------------------------------------------------- logging

class Log(object):
    """stderr logging, with journald priority prefixes when under systemd."""

    PREFIX = {"err": "<3>", "warn": "<4>", "info": "<6>", "debug": "<7>"}

    def __init__(self):
        self.verbose = False
        self.kmsg = False
        self.journal = bool(os.environ.get("JOURNAL_STREAM"))

    def _emit(self, level, msg):
        if self.journal:
            line = "%s%s\n" % (self.PREFIX[level], msg)
        else:
            line = "%s [%s] %s\n" % (time.strftime("%H:%M:%S"), level, msg)
        try:
            sys.stderr.write(line)
            sys.stderr.flush()
        except Exception:
            pass
        if self.kmsg:
            try:
                with open("/dev/kmsg", "w") as k:
                    k.write("rhodep-gnss: %s\n" % msg)
            except Exception:
                self.kmsg = False

    def error(self, m, *a):
        self._emit("err", m % a if a else m)

    def warn(self, m, *a):
        self._emit("warn", m % a if a else m)

    def info(self, m, *a):
        self._emit("info", m % a if a else m)

    def debug(self, m, *a):
        if self.verbose:
            self._emit("debug", m % a if a else m)


