From: postmarketOS rhodep port
Subject: [PATCH] arm64: dts: qcom: rhodep: add IPA node (disabled)

Add the IPA node for the Motorola Moto G82 5G (SM6375). Addresses, GSI
region and interrupts match the downstream Motorola SM6375 kernel
(holi.dtsi: qcom,ipa@0x5800000, GIC_SPI 257/259) and the SM6375-derived
agatti.dtsi already in mainline (ipa@5840000). The ipa-shared window is
0x3000 to cover the IPA v4.11 memory map (region MODEM ends at 0x2f24).

The modem loads the GSI firmware (qcom,gsi-loader = "modem"); the modem
subsystem is already running on this port and its IPA control service is
visible over QRTR, so no separate ipa_fws.mdt load is needed from the AP.

The node is left status = "disabled". The matching "qcom,sm6375-ipa"
compatible selects an IPA v4.11 config with interconnect_count = 0, so the
driver can probe without an interconnect provider (mainline has none for
SM6375). However, configuring the GSI hardware without the NoC buses voted
up resets the SoC. The node and driver support are in place so enabling
data is a one-line status change once an SM6375 interconnect driver lands.

--- a/arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts
+++ b/arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts
@@ -1150,4 +1150,44 @@
 				<&gpucc GPU_GX_GDSC>;
 		power-domain-names = "cx", "gx";
 	};
+
+	ipa: ipa@5840000 {
+		compatible = "qcom,sm6375-ipa";
+
+		iommus = <&apps_smmu 0x4a0 0x0>;
+		reg = <0x0 0x05840000 0x0 0x7000>,
+		      <0x0 0x05847000 0x0 0x3000>,
+		      <0x0 0x05804000 0x0 0x2c000>;
+		reg-names = "ipa-reg",
+			    "ipa-shared",
+			    "gsi";
+
+		interrupts-extended = <&intc GIC_SPI 257 IRQ_TYPE_EDGE_RISING>,
+				      <&intc GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>,
+				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa",
+				  "gsi",
+				  "ipa-clock-query",
+				  "ipa-setup-ready";
+
+		clocks = <&rpmcc RPM_SMD_IPA_CLK>;
+		clock-names = "core";
+
+		qcom,smem-states = <&ipa_smp2p_out 0>,
+				   <&ipa_smp2p_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+
+		qcom,gsi-loader = "modem";
+
+		/*
+		 * Kept disabled: mainline has no SM6375 interconnect provider,
+		 * so the IPA has no NoC bandwidth votes. The driver probes with
+		 * interconnect_count = 0, but configuring the GSI hardware
+		 * without the buses voted up resets the SoC. Flip to "okay"
+		 * once an SM6375 interconnect driver exists.
+		 */
+		status = "disabled";
+	};
 };
