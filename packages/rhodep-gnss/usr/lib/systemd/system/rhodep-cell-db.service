[Unit]
Description=rhodep: rebuild the offline OpenCelliD cell-tower database
Documentation=file:/usr/share/doc/rhodep-gnss/README
# Streams a 1.1 GB dump, so it wants a link that is actually up rather than
# merely configured.
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/default/rhodep-cell-db

[Service]
Type=oneshot
EnvironmentFile=/etc/default/rhodep-cell-db
# $MCC and $SOURCE are comma-separated single tokens; rhodep-cell-db splits
# them itself so that no shell is needed here.
#
# $TOKEN_ARG is empty or the whole flag, e.g. "--token abcdef", and it is
# unquoted on purpose. systemd.service(5): an unquoted $VAR used as a word of
# its own is "replaced by the value of the environment variable split at
# whitespace, resulting in zero or more arguments" -- zero when the variable
# is empty or unset, which is the case for every install that has not put a
# token in /etc/default/rhodep-cell-db. So the default command line is
# byte-for-byte the one this unit shipped before the variable existed.
# ${TOKEN_ARG} would be WRONG: the braced form always yields exactly one
# argument, so an unset token would pass an empty string and a set one would
# pass "--token abcdef" as a single argv entry that argparse rejects. That
# distinction is spelled out in the systemd.service(5) example with THREE=.
# The variable is not required to exist: an admin whose conffile predates it
# gets the same zero arguments, because systemd treats an unknown variable as
# an empty string.
ExecStart=/usr/local/sbin/rhodep-cell-db build --mcc $MCC --source $SOURCE \
          --output $DB $TOKEN_ARG
# This is background housekeeping competing with a phone someone is using.
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
# Half an hour on a slow link is normal; four is not.
TimeoutStartSec=4h

# It downloads a file and writes one directory. Nothing else.
DynamicUser=no
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rhodep-gnss
StateDirectory=rhodep-gnss
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
