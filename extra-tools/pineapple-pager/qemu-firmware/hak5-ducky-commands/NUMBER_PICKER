#!/bin/bash
# NUMBER_PICKER - WiFi Pineapple Pager DuckyScript command (host bridge).
# Numeric entry dialog. BLOCKS until the user confirms/cancels; echoes the entered value.
# Usage: resp=$(NUMBER_PICKER "Prompt?" ["default"])
# Exit codes mirror pineapple.sh (0 confirmed, 2 cancelled, 4 error).
. /lib/hak5/pineapple.sh

__message="$1"
__default="$2"

json=$(cat << JEOF
{ "message": $(SAFE_JSON_STRING "${__message}"), "default": $(SAFE_JSON_STRING "${__default}") }
JEOF
)

if HAK5_API_POST "payload/interact/number_picker" "${json}"; then
    json_get_var __val value 2>/dev/null
    [ -z "$__val" ] && json_get_var __val result 2>/dev/null
    [ -z "$__val" ] && json_get_var __val text 2>/dev/null
    printf '%s' "$__val"
    exit ${DUCKYSCRIPT_USER_CONFIRMED}
fi
exit ${DUCKYSCRIPT_ERROR}
