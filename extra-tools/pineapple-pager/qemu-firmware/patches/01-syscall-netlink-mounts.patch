+/* PINEAPPLE PAGER SHIM: fake /proc/mounts so the firmware's overlay-ready
+ * check passes. It polls /proc/mounts for an "overlayfs /overlay" entry. */
+static int pager_is_proc(const char *filename, const char *entry)
+{
+    return strcmp(filename, entry) == 0;
+}
+static int open_pager_mounts(CPUArchState *cpu_env, int fd)
+{
+    static const char *mounts =
+        "rootfs / rootfs rw 0 0\n"
+        "proc /proc proc rw,nosuid,nodev,noexec,relatime 0 0\n"
+        "sysfs /sys sysfs rw,nosuid,nodev,noexec,relatime 0 0\n"
+        "tmpfs /tmp tmpfs rw,nosuid,nodev,relatime 0 0\n"
+        "ubi0:rootfs /rom squashfs ro,relatime 0 0\n"
+        "overlayfs:/overlay /overlay overlay rw,noatime,"
+        "lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work 0 0\n"
+        "overlayfs:/overlay / overlay rw,noatime,"
+        "lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work 0 0\n"
+        "tmpfs /dev tmpfs rw,relatime,size=512k,mode=755 0 0\n";
+    size_t n = strlen(mounts);
+    if (write(fd, mounts, n) != (ssize_t)n) {
+        return -1;
+    }
+    return 0;
+}
