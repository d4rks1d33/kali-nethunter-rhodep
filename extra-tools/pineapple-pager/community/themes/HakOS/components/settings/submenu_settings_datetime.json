{
  "screen_name": "settings_datetime_submenu",
  "status_bar": "default",
  "windowed_canvas": false,
  "cache_canvases": false,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "noop",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/settings_bg.png", "x": 0, "y": 0 }
    ]
  },
  "menu_items": [
    {
      "id": "Date/Time",
      "x":10,
      "y":50,
      "unselectable": true,
      "layers": [
        { "variable_name": "$_DATETIME", "string_template":
          { "text_size": "medium",
            "text_color_palette": "white",
            "max_chars": 24,
            "wrap_text": false,
            "max_lines": 1
          }
        }
      ]
    },
    {
      "id": "24 Hour Clock",
      "x":10,
      "y":85,
      "layers": [
        { "variable_name":  "$_CLOCK_24HR", "use_template": "toggle" },
        { "text": "24 Hour Clock", "x": 40, "text_color_palette": "white" }
      ],
      "selected_layers": [
        { "variable_name":  "$_CLOCK_24HR", "use_template": "toggle" },
        { "text": "24 Hour Clock", "x": 40, "text_color_palette": "blue" }
      ],
      "button_map": {
        "a": "select",
        "b": "back",
        "up": "previous",
        "down": "next",
        "left": "noop",
        "right": "goto Day"
      },
      "target": "inline_toggle",
      "variable": "$_CLOCK_24HR"
    },
    {
      "id": "Timezone",
      "x":10,
      "y":120,
      "layers": [
        { "image_path": "assets/menu.png" },
        { "text": "Timezone", "x": 40, "text_color_palette": "white" }
      ],
      "selected_layers": [
        { "image_path": "assets/menu.png" },
        { "text": "Timezone", "x": 40, "text_color_palette": "blue" }
      ],
      "button_map": {
        "a": "select",
        "b": "back",
        "up": "previous",
        "down": "next",
        "left": "noop",
        "right": "goto Hour"
      },
      "target": "option_dialog",
      "variable": "$_TIMEZONE"
    },
    {
      "id": "Year",
      "x":10,
      "y":155,
      "layers": [
        { "image_path": "assets/keyboard.png" },
        { "text": "Year", "x": 40, "text_color_palette": "white" }
      ],
      "selected_layers": [
        { "image_path": "assets/keyboard.png" },
        { "text": "Year", "x": 40, "text_color_palette": "blue" }
