#!/bin/sh
# rhodep-pwn-monstart-dispatch: pick the right monstart for whichever radio the
# drop-in selected. Used as pwnagotchi's main.mon_start_cmd so the agent's own
# retry-on-missing-iface path also honours the same radio choice (in practice
# the bettercap service already brought the iface up and the underlying
# monstart takes its fast-path here).
set -e

RADIO=${RHODEP_PWN_RADIO:-external}
case "$RADIO" in
	internal) exec /usr/local/sbin/rhodep-pwn-monstart-internal ;;
	external|"") exec /usr/local/sbin/rhodep-pwn-monstart ;;
	*) echo "rhodep-pwn-monstart-dispatch: unknown RHODEP_PWN_RADIO=$RADIO" >&2; exit 2 ;;
esac
