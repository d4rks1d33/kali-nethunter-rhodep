		timer {
			compatible = "arm,armv8-timer";
			interrupts = <0x01 0x01 0xff08 0x01 0x02 0xff08 0x01 0x03 0xff08 0x01 0x00 0xff08>;
			clock-frequency = <0x124f800>;
			phandle = <0x1e9>;
		};

		timer@f420000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			compatible = "arm,armv7-timer-mem";
			reg = <0xf420000 0x1000>;
			clock-frequency = <0x124f800>;
			phandle = <0x1ea>;

			frame@f421000 {
				frame-number = <0x00>;
				interrupts = <0x00 0x08 0x04 0x00 0x06 0x04>;
				reg = <0xf421000 0x1000 0xf422000 0x1000>;
			};

			frame@f423000 {
				frame-number = <0x01>;
				interrupts = <0x00 0x09 0x04>;
				reg = <0xf243000 0x1000>;
				status = "disabled";
			};

			frame@f425000 {
				frame-number = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
				reg = <0xf425000 0x1000>;
				status = "disabled";
			};

			frame@f427000 {
				frame-number = <0x03>;
				interrupts = <0x00 0x0b 0x04>;
				reg = <0xf427000 0x1000>;
				status = "disabled";
			};

			frame@f429000 {
				frame-number = <0x04>;
				interrupts = <0x00 0x0c 0x04>;
				reg = <0xf429000 0x1000>;
				status = "disabled";
			};

			frame@f42b000 {
				frame-number = <0x05>;
				interrupts = <0x00 0x0d 0x04>;
				reg = <0xf42b000 0x1000>;
				status = "disabled";
			};

			frame@f42d000 {
				frame-number = <0x06>;
				interrupts = <0x00 0x0e 0x04>;
				reg = <0xf42d000 0x1000>;
				status = "disabled";
			};
		};

		cpu-pmu {
			compatible = "arm,armv8-pmuv3";
			qcom,irq-is-percpu;
			interrupts = <0x01 0x05 0x04>;
			phandle = <0x1eb>;
		};

		qcom-secure-buffer {
			compatible = "qcom,secure-buffer";
		};

