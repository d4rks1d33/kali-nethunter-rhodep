#!/usr/bin/python3
"""rhodep-modem-at - an AT command console for the modem.

The Moto G82's modem answers AT commands, and until this existed nothing on the
port used them. They do not travel over a serial port: the modem's glink edge
advertises channels named DS and DATA1..DATA11, none of which any driver binds,
and two of them speak AT. An endpoint is created on one with rpmsg_ctrl and the
result is an ordinary read/write file descriptor.

    GLINK edge (6080000.remoteproc)
      └── DS  /  DATA1
           └── /dev/rpmsg_ctrl2 + RPMSG_CREATE_EPT_IOCTL
                └── /dev/rpmsgN
                     └── AT

That path goes through neither QMI nor DIAG, so it keeps working when
ModemManager is not running, and it does not depend on the debug fuses, which
on this handset are closed.

Usage:

    sudo rhodep-modem-at                 interactive console
    sudo rhodep-modem-at ATI             one command and exit
    sudo rhodep-modem-at -c DATA1 ATI    the same, on the other channel
    sudo rhodep-modem-at -l              list the channels the modem advertises

In the console, "?" prints a crib sheet of useful commands, and Ctrl-D or
"quit" exits. Anything else is sent verbatim, so you do not need to remember
which commands this tool knows about -- it knows about none of them, it is a
pipe.

Two things that will confuse you if nobody says them:

  * a write can fail with EBUSY. That is glink reporting that the modem has not
    posted a receive buffer, not the port being dead. This tool opens the
    endpoint blocking and bounds every operation with an alarm, which is why it
    never hangs.
  * the port echoes. Each command is drained first and then read until a final
    result code, so what you see is the answer and not the echo of whatever you
    typed before.
"""

import argparse
import fcntl
import glob
import os
import select
import signal
import struct
import sys
import time

RPMSG_CREATE_EPT_IOCTL = (1 << 30) | (40 << 16) | (0xB5 << 8) | 0x01
RPMSG_DESTROY_EPT_IOCTL = (0xB5 << 8) | 0x02          # _IO(0xb5, 0x2)
MODEM_EDGE = "6080000.remoteproc"

CRIB = """
Every command below was tried against this modem and answers; the ones it does
not support are called out, so the list is what works rather than what usually
works.

identity and firmware
  ATI                     manufacturer, model, firmware revision, IMEI
  AT+CGMR                 firmware revision on its own
  AT+CGSN                 IMEI
  AT+CIMI                 IMSI

radio and registration
  AT+CFUN?                1 = radio on, 0 = off, 4 = airplane
  AT+COPS?                operator and access technology
                          (the last field: 0 GSM, 2 UTRAN, 3 EDGE, 7 LTE)
  AT+CEREG?               LTE registration:  0,1 registered  0,2 searching
  AT+CGREG?               GPRS/EDGE registration
  AT+CSQ                  signal: 0-31 and bit error rate; 99 means unknown
  AT+CPAS                 activity status; 4 means a call is in progress
  AT+CEER                 extended cause for the last failure
  AT+CESQ                 NOT supported by this firmware, answers ERROR

SIM
  AT$QCSIMSTAT?           SIM init state
  AT+CNUM                 own number, empty on this SIM

data
  AT+CGDCONT?             defined PDP contexts (APNs)
  AT+CGACT?               which contexts are active
  AT+CGCONTRDP            the live context: IP, gateway, DNS

behaviour
  AT+CMEE=2               verbose errors instead of a bare ERROR

vendor
  AT$QCDMG                would switch this port into DIAG mode and give the
                          modem's own F3 log.  Answers ERROR on this firmware,
                          which is why that log is out of reach --
                          see docs/watchdog-ipa-lte-wip/HANDOFF.md

Careful with AT+CFUN=0/1 and anything that writes: this is the real modem of a
working phone, and some commands persist across reboots.
"""



# Every command below came from this modem's own AT+CLAC, which lists 256 of
# them. They are grouped by what they do to the device, not by what they are
# called, because that is the distinction that matters when you are poking at
# the radio of a phone you need to keep working.

# Read-only. Verified against this modem: safe to fire at will.
SAFE = [
    "ATI", "AT+CGMI", "AT+CGMM", "AT+CGMR", "AT+CGSN", "AT+CIMI", "AT+ICCID",
    "AT+GCAP", "AT+CNUM", "AT+CPAS", "AT+CFUN?", "AT+COPS?", "AT+CREG?",
    "AT+CGREG?", "AT+CEREG?", "AT+C5GREG?", "AT+CSQ", "AT+CEER", "AT+CBC",
    "AT+CGDCONT?", "AT+CGACT?", "AT+CGATT?", "AT+CGPADDR", "AT+CGCONTRDP",
    "AT+CPIN?", "AT+CLCC", "AT+CIND?", "AT+CSCA?", "AT+CPMS?", "AT+CMGF?",
    "AT+CCLK?", "AT+CTZU?", "AT+WS46?", "AT+CEMODE?", "AT+CGCLASS?",
    "AT$QCSIMSTAT?", "AT$QCPINSTAT?", "AT$QCSYSMODE?", "AT$QCHWREV",
    "AT$QCBOOTVER", "AT$QCSQ", "AT$QCRSRP", "AT$QCRSRQ", "AT$QCRSCP",
    "AT$QCECNO", "AT$QCBANDPREF?", "AT$QCDRX?", "AT$QCMSISDN?", "AT$QCCLAC",
    "AT^SYSINFO", "AT^SPN", "AT^CARDMODE", "AT+CLAC",
]

# Changes state. Reversible, but it is a live radio.
CONFIG = [
    "AT+CFUN=", "AT+COPS=", "AT+CGDCONT=", "AT+CGATT=", "AT+CMEE=",
    "AT+CMGF=", "AT+CNMI=", "AT+CTZU=", "AT+WS46=", "AT+CEMODE=",
    "AT$QCBANDPREF=", "AT$QCDRX=", "AT$QCPDPP=", "AT$QCAPNE=",
    "AT^SYSCONFIG", "AT^PREFMODE",
]

# Do not send these casually. Each one either drops the radio, writes something
# that survives a reboot, or -- for the last group -- is simply unknown and one
# of the batch that wedged this phone hard enough to need the power button.
DANGEROUS = {
    "AT$QCPWRDN":   "powers the modem down",
    "AT+CFUN=0":    "drops the radio",
    "AT+CFUN=1,1":  "resets the modem",
    "AT+CRES":      "restores SMS settings from the SIM",
    "AT+CSAS":      "saves SMS settings to the SIM",
    "AT+CPWD":      "changes a SIM password",
    "AT+CLCK":      "locks or unlocks the SIM",
    "AT+CPIN=":     "burns a PIN attempt if it is wrong",
    "AT$QCCLR":     "clears something -- semantics unknown",
    "AT$QCACQDBC":  "clears the acquisition database, costs a slow re-scan",
    "AT$QCDGEN":    "traffic generator",
    "AT$QCRMCALL":  "brings up a data call behind ModemManager's back",
    "AT$QCVOLT":    "UNKNOWN. In the batch that wedged the AP; see the README",
    "AT$QCDMR":     "UNKNOWN. DM/DIAG related; $QCDMG is not even in this "
                    "firmware's strings, so it is unlikely to open DIAG",
    "AT$QCTER":     "UNKNOWN. Also in the batch that wedged the AP",
}


class Timeout(Exception):
    pass


def _alarm(*_):
    raise Timeout()


signal.signal(signal.SIGALRM, _alarm)


def list_channels():
    out = []
    for p in sorted(glob.glob("/sys/bus/rpmsg/devices/*")):
        base = os.path.basename(p)
        if base.startswith(MODEM_EDGE):
            out.append(base.split("glink-edge.", 1)[-1].rsplit(".", 2)[0])
    return out


def modem_ctrl():
    """Find the rpmsg control device belonging to the modem's glink edge.

    Do not hardcode /dev/rpmsg_ctrlN. The number depends on the order the
    remoteprocs probe and really does move between boots -- the modem was
    rpmsg_ctrl2 on one boot and rpmsg_ctrl3 on the next, which made this tool
    fail with a bare ENOENT.
    """
    for c in sorted(glob.glob("/sys/class/rpmsg/rpmsg_ctrl*")):
        try:
            target = os.path.realpath(c)
        except OSError:
            continue
        if MODEM_EDGE in target:
            dev = "/dev/" + os.path.basename(c)
            if os.path.exists(dev):
                return dev
    return None


def endpoint_name(dev):
    """Channel name behind a /dev/rpmsgN, from sysfs."""
    try:
        with open("/sys/class/rpmsg/%s/name" % os.path.basename(dev)) as f:
            return f.read().strip()
    except OSError:
        return None


def existing_endpoints(name=None):
    out = []
    for dev in sorted(glob.glob("/dev/rpmsg[0-9]*")):
        n = endpoint_name(dev)
        if n and (name is None or n == name):
            out.append((dev, n))
    return out


def destroy(dev):
    """Release an endpoint so the channel can be opened again."""
    try:
        fd = os.open(dev, os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.ioctl(fd, RPMSG_DESTROY_EPT_IOCTL)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def open_channel(name):
    """Return (fd, device, we_created_it) for a named glink channel.

    An endpoint left behind by a previous run keeps the channel busy: glink
    will not create a second one and open() then fails with EINVAL, which reads
    exactly like the modem refusing the channel. So reuse one if it is there,
    and destroy whatever we create on the way out.
    """
    ctrl = modem_ctrl()
    if not ctrl:
        raise SystemExit(
            "no rpmsg control device for %s.\n"
            "Is rpmsg_ctrl loaded and the modem running?\n"
            "  lsmod | grep rpmsg_ctrl\n"
            "  cat /sys/class/remoteproc/remoteproc0/state" % MODEM_EDGE)

    for dev, _ in existing_endpoints(name):
        try:
            return os.open(dev, os.O_RDWR), dev, False
        except OSError:
            destroy(dev)                       # stale and unopenable: clear it

    before = set(glob.glob("/dev/rpmsg[0-9]*"))
    fd = os.open(ctrl, os.O_RDWR)
    try:
        fcntl.ioctl(fd, RPMSG_CREATE_EPT_IOCTL,
                    struct.pack("32sII", name.encode(), 0xFFFFFFFF, 0xFFFFFFFF))
    except OSError as e:
        os.close(fd)
        raise SystemExit("cannot create an endpoint on %s: %s" % (name, e))
    os.close(fd)

    for _ in range(20):
        time.sleep(0.1)
        new = sorted(set(glob.glob("/dev/rpmsg[0-9]*")) - before)
        if new:
            break
    else:
        raise SystemExit("no /dev/rpmsgN appeared for channel %s" % name)

    dev = new[-1]
    try:
        # Blocking on purpose: a non-blocking write returns EBUSY whenever the
        # modem has not posted a receive intent yet.
        return os.open(dev, os.O_RDWR), dev, True
    except OSError as e:
        destroy(dev)
        raise SystemExit(
            "channel %s created %s but will not open: %s\n"
            "The modem does not acknowledge that channel. DS and DATA1 answer;\n"
            "DIAG never does." % (name, dev, e))


def drain(fd, secs=0.3):
    end = time.monotonic() + secs
    while time.monotonic() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if not r:
            continue
        try:
            signal.alarm(2)
            os.read(fd, 4096)
        except (Timeout, OSError):
            break
        finally:
            signal.alarm(0)


def command(fd, cmd, wait=5.0):
    drain(fd)
    try:
        signal.alarm(3)
        os.write(fd, (cmd + "\r\n").encode())
    except Timeout:
        return "(write blocked: the modem posted no receive buffer)"
    except OSError as e:
        return "(write failed: %s)" % e
    finally:
        signal.alarm(0)

    end = time.monotonic() + wait
    buf = b""
    while time.monotonic() < end:
        r, _, _ = select.select([fd], [], [], 0.2)
        if not r:
            continue
        try:
            signal.alarm(2)
            buf += os.read(fd, 4096)
        except (Timeout, OSError):
            break
        finally:
            signal.alarm(0)
        tail = buf.strip()
        if tail.endswith(b"OK") or tail.endswith(b"ERROR") or b"+CME ERROR" in buf:
            break

    text = buf.decode("ascii", "replace")
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    if lines and lines[0].strip().upper() == cmd.strip().upper():
        lines = lines[1:]                       # drop the echo
    return "\n".join(lines) if lines else "(no answer)"


def kmsg(text):
    """Leave a trace that survives a reset, in ramoops."""
    try:
        with open("/dev/kmsg", "w") as k:
            k.write("modem-at: %s\n" % text)
    except OSError:
        pass


def uptime():
    try:
        with open("/proc/uptime") as f:
            return float(f.read().split()[0])
    except OSError:
        return -1.0


def danger(cmd):
    up = cmd.strip().upper()
    for k, why in DANGEROUS.items():
        if up.startswith(k.upper()):
            return why
    return None


def probe(fd, cmd, force=False):
    """Send one command, having first written it where a reset cannot erase it.

    This exists because ten Qualcomm vendor commands were once sent in a batch
    with no trace, one of them wedged the application processor hard enough to
    need the power button, and there was no way afterwards to tell which. A
    marker in /dev/kmsg lands in the ramoops console record, so the last thing
    tried is always recoverable from the next boot.
    """
    why = danger(cmd)
    if why and not force:
        print("%s is on the do-not-send list: %s" % (cmd, why))
        print("re-run with --force if you mean it, and read the console record")
        print("afterwards with:  sudo rhodep-pstore-keep ; less /root/pstore-history/*")
        return

    before = uptime()
    kmsg("sending %s (uptime %.2f)" % (cmd, before))
    print("marker written; sending %s" % cmd)
    answer = command(fd, cmd)
    after = uptime()
    kmsg("survived %s (uptime %.2f)" % (cmd, after))
    print(answer)
    print("--- still alive, uptime %.2f -> %.2f" % (before, after))


def list_commands(fd):
    """Ask the modem for its own command set and classify it."""
    listing = command(fd, "AT+CLAC", wait=10.0)
    names = []
    for line in listing.splitlines():
        line = line.strip()
        if not line or line in ("OK", "ERROR"):
            continue
        names.append(line if line.startswith("AT") else "AT" + line)
    if not names:
        print("AT+CLAC returned nothing usable:")
        print(listing)
        return
    print("the modem implements %d commands\n" % len(names))

    def group(pred):
        return sorted(n for n in names if pred(n))

    risky = group(lambda n: danger(n))
    vendor = group(lambda n: (n.startswith("AT$") or n.startswith("AT^")) and not danger(n))
    std = group(lambda n: n.startswith("AT+") and not danger(n))
    basic = group(lambda n: not n.startswith(("AT+", "AT$", "AT^")))

    for title, items in (("do not send casually", risky),
                         ("vendor ($ and ^)", vendor),
                         ("standard (+)", std),
                         ("basic / S-registers", basic)):
        print("%s: %d" % (title, len(items)))
        line = "  "
        for i in items:
            if len(line) + len(i) > 96:
                print(line); line = "  "
            line += i.replace("AT", "", 1) + " "
        if line.strip():
            print(line)
        print()
    print("Nothing above was executed. Use --probe to try one, with a marker.")


def main():
    ap = argparse.ArgumentParser(
        description="AT console for the modem, over glink rather than a serial port.")
    ap.add_argument("-c", "--channel", default="DS",
                    help="glink channel to use (default DS; DATA1 also answers)")
    ap.add_argument("-l", "--list", action="store_true",
                    help="list the channels the modem advertises and exit")
    ap.add_argument("--commands", action="store_true",
                    help="ask the modem for its own command list and classify it, "
                         "executing nothing")
    ap.add_argument("--probe", metavar="CMD",
                    help="send one command with a marker in /dev/kmsg first, so "
                         "that if it takes the phone down the ramoops record says which")
    ap.add_argument("--force", action="store_true",
                    help="allow --probe to send a command on the do-not-send list")
    ap.add_argument("--cleanup", action="store_true",
                    help="release endpoints left behind by earlier runs and exit")
    ap.add_argument("cmd", nargs="*", help="a single command to run, then exit")
    args = ap.parse_args()

    if args.list:
        chans = list_channels()
        print("channels advertised by the modem edge:")
        for c in chans:
            print("  %s%s" % (c, "   <- answers AT" if c in ("DS", "DATA1") else ""))
        if not chans:
            print("  (none: is the modem running?)")
        print("\nmodem rpmsg control device: %s" % (modem_ctrl() or "NOT FOUND"))
        held = existing_endpoints()
        if held:
            print("\nendpoints currently open:")
            for dev, n in held:
                print("  %s -> %s" % (dev, n))
        return

    if os.geteuid() != 0:
        print("needs root (the rpmsg control device is root-only)", file=sys.stderr)
        return 1

    if args.cleanup:
        held = existing_endpoints()
        if not held:
            print("nothing to release")
            return
        for dev, n in held:
            print("%s (%s): %s" % (dev, n, "released" if destroy(dev) else "would not release"))
        return

    fd, dev, mine = open_channel(args.channel)
    try:
        if args.commands:
            list_commands(fd)
            return
        if args.probe:
            probe(fd, args.probe, args.force)
            return
        if args.cmd:
            print(command(fd, " ".join(args.cmd)))
            return

        print("modem AT console on %s (%s). '?' for a crib sheet, Ctrl-D to quit."
              % (args.channel, dev))
        hello = command(fd, "AT")
        print("AT -> %s" % hello)
        if "OK" not in hello:
            print("that channel does not look like an AT port; try -c DATA1")

        while True:
            try:
                line = input("at> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                continue
            if line in ("quit", "exit"):
                break
            if line == "?":
                print(CRIB)
                continue
            print(command(fd, line))
    finally:
        os.close(fd)
        # Leaking an endpoint keeps the channel busy for every later run, which
        # is how this tool broke itself the first time.
        if mine:
            destroy(dev)


if __name__ == "__main__":
    sys.exit(main() or 0)
