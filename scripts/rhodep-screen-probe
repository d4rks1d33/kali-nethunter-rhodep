#!/bin/bash
# Snapshot del estado de pantalla/panel. Uso: rhodep-screen-probe [etiqueta]
S=/sys/class/drm/card0/card0-DSI-1
B=/sys/class/backlight/5e94000.dsi.0
ST=/sys/kernel/debug/dri/0/state
printf '%s | %-22s | up=%s\n' "$(date +%H:%M:%S)" "${1:-probe}" "$(cut -d. -f1 /proc/uptime)"
printf '  backlight: bright=%-5s power=%-2s | dpms=%-4s enabled=%-8s status=%s\n' \
  "$(cat $B/brightness 2>/dev/null)" "$(cat $B/bl_power 2>/dev/null)" \
  "$(cat $S/dpms 2>/dev/null)" "$(cat $S/enabled 2>/dev/null)" "$(cat $S/status 2>/dev/null)"
printf '  crtc: %s\n' "$(grep -A4 'crtc\[' $ST 2>/dev/null | grep -E 'enable=|active=' | tr -d '\t' | tr '\n' ' ')"
printf '  runtime_pm: mdss=%s dsi=%s | clk mdss=%s\n' \
  "$(cat /sys/devices/platform/soc@0/5e00000.display-subsystem/power/runtime_status 2>/dev/null)" \
  "$(cat /sys/devices/platform/soc@0/5e00000.display-subsystem/5e01000.display-controller/power/runtime_status 2>/dev/null)" \
  "$(grep -c . /dev/null)"
