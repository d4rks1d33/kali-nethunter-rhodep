+			    arvif->vdev_id, bcn->len, ret);
 	kfree_skb(bcn);
 
 	if (ret) {
@@ -1835,6 +1849,9 @@ static void ath10k_control_beaconing(str
 
 	ret = ath10k_wmi_vdev_up(arvif->ar, arvif->vdev_id, arvif->aid,
 				 arvif->bssid);
+	if (ath10k_mon_mgmt)
+		ath10k_info(ar, "rhodep AP vdev-up id=%d bssid=%pM ret=%d\n",
+			    arvif->vdev_id, arvif->bssid, ret);
 	if (ret) {
 		ath10k_warn(ar, "failed to bring up vdev %d: %i\n",
 			    arvif->vdev_id, ret);
@@ -3747,7 +3764,21 @@ ath10k_mac_tx_h_get_txmode(struct ath10k
 	if (IEEE80211_SKB_CB(skb)->flags & IEEE80211_TX_CTL_HW_80211_ENCAP)
 		return ATH10K_HW_TXRX_ETHERNET;
 
-	if (!vif || vif->type == NL80211_IFTYPE_MONITOR)
+	/* rhodep: injecting from a monitor vif normally goes through the HTT raw
+	 * TX path, but WCN3990's WLAN.HL.3.3.2 firmware asserts (crashes) on a raw
+	 * HTT MSDU submitted on a peerless vdev. Management frames, however, have a
+	 * firmware-supported route: the WMI mgmt-tx-by-reference command. So for a
+	 * monitor vif, send mgmt frames (deauth/disassoc/auth/probe/action) via the
+	 * MGMT txmode/WMI path instead of raw HTT. Non-mgmt (data) injection has no
+	 * safe path on this firmware and is left on RAW (it will be dropped/unsafe).
+	 */
+	if (vif && vif->type == NL80211_IFTYPE_MONITOR) {
+		if (ath10k_mon_mgmt && ieee80211_is_mgmt(fc))
+			return ATH10K_HW_TXRX_MGMT;
+		return ATH10K_HW_TXRX_RAW;
+	}
+
+	if (!vif)
 		return ATH10K_HW_TXRX_RAW;
 
 	if (ieee80211_is_mgmt(fc))
@@ -4083,11 +4114,14 @@ static int ath10k_mac_tx(struct ath10k *
 		break;
 	case ATH10K_HW_TXRX_RAW:
 		if (!test_bit(ATH10K_FLAG_RAW_MODE, &ar->dev_flags) &&
-		    !(skb_cb->flags & ATH10K_SKB_F_RAW_TX)) {
+		    !(skb_cb->flags & ATH10K_SKB_F_RAW_TX) &&
+		    !(vif && vif->type == NL80211_IFTYPE_MONITOR)) {
 			WARN_ON_ONCE(1);
 			ieee80211_free_txskb(hw, skb);
 			return -EOPNOTSUPP;
 		}
+		/* Monitor vif: frame is a raw 802.11 frame from userspace.
+		 * Let the HTT raw TX descriptor reach the firmware. */
 	}
 
 	if (!noque_offchan && info->flags & IEEE80211_TX_CTL_TX_OFFCHAN) {
@@ -4237,23 +4271,695 @@ void ath10k_mgmt_over_wmi_tx_purge(struc
 	}
 }
 
+/* rhodep: WCN3990 firmware only radiates a mgmt frame if the target vdev has a
+ * peer/tx-context for the destination; a monitor vdev has none, so injected
+ * frames "complete" with status=1 and never hit the air. Mirror the driver's
+ * own offchannel trick (ath10k_offchan_tx_work): create a temporary peer for
+ * the frame's destination on the monitor vdev, send, then delete it. Returns
+ * the vdev_id a temp peer was created on (>=0, caller must delete), -2 if a
+ * per-DA peer was created/reused on the hidden STA vdev (caller MUST NOT
+ * delete; kept in LRU cache), or -1 if no peer was created at all.
+ */
+static int ath10k_mon_inject_peer_add(struct ath10k *ar, struct sk_buff *skb,
+				      u8 *peer_addr_out)
+{
+	struct ieee80211_hdr *hdr = (void *)skb->data;
+	struct ath10k_vif *arvif;
+	const u8 *da;
+	int vdev_id = -1;
+
+	if (!ath10k_mon_mgmt)
+		return -1;
+	if (!ar->monitor_started && !ar->monitor_arvif && !ar->monitor)
+		return -1;
+
+	/* rhodep Experiment 1 (Sep 2026): NO per-DA peer_create.
+	 *
+	 * We now create the hidden vdev as WMI_VDEV_TYPE_AP + VDEV_UP with
+	 * the self-MAC as BSSID. AP vdevs use the AP self-peer at vdev+0xc
+	 * as the tx peer for ANY addr1 unicast, so we do not need per-DA
+	 * peers. This also avoids the cmnos_thread.c:4005:A assert that
+	 * hit us when we did peer_create on a peerless (never-UP'd) STA
+	 * vdev.
+	 *
+	 * If fw crashed/restarted, invalidate so the mgmt-tx worker
+	 * recreates the hidden vdev on the next frame.
+	 */
+	if (ar->rhodep_inject.created) {
+		if (ar->state != ATH10K_STATE_ON) {
+			ath10k_info(ar,
+				    "rhodep: fw not in state=ON (%d), invalidating hidden vdev\n",
+				    ar->state);
+			spin_lock_bh(&ar->rhodep_inject.lock);
+			ar->rhodep_inject.created = false;
+			memset(ar->rhodep_inject.peer_cache, 0,
+			       sizeof(ar->rhodep_inject.peer_cache));
+			spin_unlock_bh(&ar->rhodep_inject.lock);
+			return -1;
+		}
+		/* Signal caller: "use hidden vdev, no peer setup or
+		 * teardown needed". peer_addr_out is unused in this path.
+		 */
+		return -1; /* -1 = skip both add & del legacy paths */
+	}
+
+	/* Legacy path (monitor vdev inject, pre-Loukious). Kept as fallback. */
+	if (ar->monitor_arvif)
+		vdev_id = ar->monitor_arvif->vdev_id;
+	else if (ar->monitor_started)
+		vdev_id = ar->monitor_vdev_id;
+	else
+		return -1;
+
+	da = ieee80211_get_DA(hdr);
+	if (is_multicast_ether_addr(da)) {
+		ath10k_info(ar, "rhodep inj: DA %pM is mcast, no peer (vdev %d)\n",
+			    da, vdev_id);
+		return -1;
+	}
+
+	mutex_lock(&ar->conf_mutex);
+	arvif = ath10k_get_arvif(ar, vdev_id);
+	if (!arvif) {
+		ath10k_info(ar, "rhodep inj: no arvif for vdev %d\n", vdev_id);
+		mutex_unlock(&ar->conf_mutex);
+		return -1;
+	}
+	if (ath10k_peer_find(ar, vdev_id, da)) {
+		ath10k_info(ar, "rhodep inj: peer %pM already on vdev %d\n",
+			    da, vdev_id);
+		mutex_unlock(&ar->conf_mutex);
+		return -1;
+	}
+	if (ath10k_peer_create(ar, arvif->vif, NULL, vdev_id, da,
+			       WMI_PEER_TYPE_DEFAULT)) {
+		ath10k_info(ar, "rhodep inj: peer_create %pM on vdev %d FAILED\n",
+			    da, vdev_id);
+		mutex_unlock(&ar->conf_mutex);
+		return -1;
+	}
+	ath10k_info(ar, "rhodep inj: temp peer %pM created on monitor vdev %d\n",
+		    da, vdev_id);
+	mutex_unlock(&ar->conf_mutex);
+
+	ether_addr_copy(peer_addr_out, da);
+	return vdev_id;
+}
+
+static void ath10k_mon_inject_peer_del(struct ath10k *ar, int vdev_id,
+				       const u8 *peer_addr)
+{
+	if (vdev_id < 0)
+		return;
+	mutex_lock(&ar->conf_mutex);
+	/* rhodep: hidden STA vdev has no arvif in ar->peers. Use raw WMI
+	 * to avoid ath10k_peer_delete waiting on PEER_UNMAP that never fires.
+	 */
+	if (ar->rhodep_inject.created &&
+	    vdev_id == (int)ar->rhodep_inject.vdev_id)
+		ath10k_wmi_peer_delete(ar, vdev_id, peer_addr);
+	else
+		ath10k_peer_delete(ar, vdev_id, peer_addr);
+	mutex_unlock(&ar->conf_mutex);
+}
+
+/* rhodep: Loukious hidden-STA-vdev port for WCN3990 monitor-mode injection.
+ * REACTIVATED after finding the missing piece: fw returns extended status
+ * words (bit 20 set with retry metadata) that need normalization via
+ * `status & 0x3`. Fix applied in wmi.c ath10k_wmi_event_mgmt_tx_compl.
+ * Original port worked but interpreted status=0x100000 as DISCARD when it
+ * was actually COMPLETE_OK.
+ *
+ * Reference: Loukious v7 patch monitor_sta_vdev_tx_v7,
+ * github.com/Loukious/android_kernel_xiaomi_sm8150 commit 65c6a05e.
+ */
+/* Find the highest unused vdev id (walking down, skipping monitor). */
+static int ath10k_rhodep_find_free_vdev(struct ath10k *ar, u8 mon_vdev_id)
+{
+	int i;
+	int max_vid = min_t(int, TARGET_TLV_NUM_VDEVS - 2,
+				 ar->max_num_vdevs - 1);
+
+	for (i = max_vid; i >= 0; i--) {
+		if ((u8)i == mon_vdev_id)
+			continue;
+		if (!(ar->free_vdev_map & (1LL << i)))
+			continue;
+		return i;
+	}
+	return -EBUSY;
+}
+
+/* Create the hidden STA vdev + self-peer if it doesn't exist for the
+ * requested channel. If it already exists at a different chanfreq, tear
+ * it down first. Called from the mgmt tx worker; must hold conf_mutex.
+ * mon_mac_in must be a valid MAC address of the monitor vif (used to
+ * derive the injection MAC).
+ */
+static int ath10k_rhodep_ensure_inject_vdev(struct ath10k *ar,
+					     u8 mon_vdev_id,
+					     u32 chanfreq,
+					     const u8 *mon_mac_in)
+{
+	struct wmi_vdev_start_request_arg arg = {};
+	const u8 *mon_mac = NULL;
+	u8 inj_mac[ETH_ALEN];
+	int vid, ret;
+
+	(void)mon_mac; /* unused since simplified MAC derivation */
+
+	lockdep_assert_held(&ar->conf_mutex);
+
+	if (ar->rhodep_inject.created) {
+		if (ar->rhodep_inject.chanfreq == chanfreq)
+			return 0;
+
+		/* rhodep chan-change throttle. aireplay-ng WITHOUT -D hops
+		 * channels 1..13 in ~20s looking for the AP beacon; each hop
+		 * used to teardown+recreate the hidden AP vdev (10 blocking
+		 * WMIs, 500ms-8s), saturating the single WCN3990 HTC WMI
+		 * credit and tripping ath10k_core_start_recovery ->
+		 * CRASH_FLUSH -> -108 avalanche. Three layers of defense:
+		 *
+		 * (A) Fw-dead early bailout: if we've been failing recently,
+		 *     just keep the stale vdev. Frames may go out on wrong
+		 *     hidden-vdev channel briefly but nothing crashes; the
+		 *     mon vif's mac80211-side chanctx has already been
+		 *     updated to the new radio channel by the caller path.
+		 *
+		 * (B) Rate-limit: only restart at most once per second. Folds
+		 *     a 13-hop burst into at most 1-2 restarts.
+		 *
+		 * (C) In-place restart: vdev_down -> vdev_restart(new_chan)
+		 *     -> vdev_up. 3 WMIs instead of 10, no peer churn, no
+		 *     3s wait_for_peer_deleted timeout, no 5s vdev_setup_sync
+		 *     timeout on the two known-broken sync events.
+		 */
+#define ATH10K_RHODEP_CHAN_MIN_INTERVAL_MS 1000
+#define ATH10K_RHODEP_FAIL_QUIESCE_MS      5000
+#define ATH10K_RHODEP_MAX_CONSEC_FAIL      3
+
+		/* (A) */
+		if (ar->rhodep_inject.consec_fail >= ATH10K_RHODEP_MAX_CONSEC_FAIL &&
+		    time_before(jiffies,
+				ar->rhodep_inject.last_fail +
+				msecs_to_jiffies(ATH10K_RHODEP_FAIL_QUIESCE_MS))) {
+			ath10k_dbg(ar, ATH10K_DBG_MAC,
+				   "rhodep inject: chan %u->%u ignored (fw quiesce)\n",
+				   ar->rhodep_inject.chanfreq, chanfreq);
+			return 0;
+		}
+
+		/* (B) */
+		if (ar->rhodep_inject.last_chan_change &&
+		    time_before(jiffies,
+				ar->rhodep_inject.last_chan_change +
+				msecs_to_jiffies(ATH10K_RHODEP_CHAN_MIN_INTERVAL_MS))) {
+			ath10k_dbg(ar, ATH10K_DBG_MAC,
+				   "rhodep inject: chan %u->%u ignored (rate-limit)\n",
+				   ar->rhodep_inject.chanfreq, chanfreq);
+			return 0;
+		}
+
+		/* (C) in-place restart */
+		ath10k_warn(ar,
+			    "rhodep inject: chan %u->%u, restarting in place vdev=%u\n",
+			    ar->rhodep_inject.chanfreq, chanfreq,
+			    ar->rhodep_inject.vdev_id);
+
+		ret = ath10k_wmi_vdev_down(ar, ar->rhodep_inject.vdev_id);
+		if (ret == -ESHUTDOWN)
+			goto chan_change_failed;
+		/* other errors: fw may already be down for this vdev; press on */
+
+		reinit_completion(&ar->vdev_setup_done);
+		reinit_completion(&ar->vdev_delete_done);
+
+		{
+			struct wmi_vdev_start_request_arg rarg = {};
+			static const u8 dummy_ssid_r[1] = { 0 };
+
+			rarg.vdev_id = ar->rhodep_inject.vdev_id;
+			rarg.channel.freq = chanfreq;
+			rarg.channel.band_center_freq1 = chanfreq;
+			rarg.channel.band_center_freq2 = 0;
+			rarg.channel.mode = (chanfreq < 4000) ? MODE_11G : MODE_11A;
+			rarg.channel.max_power = 40;
+			rarg.channel.max_reg_power = 40;
+			rarg.channel.max_antenna_gain = 0;
+			rarg.bcn_intval = 0;
+			rarg.dtim_period = 0;
+			rarg.ssid = (u8 *)dummy_ssid_r;
+			rarg.ssid_len = 0;
+			rarg.hidden_ssid = true;
+			rarg.disable_hw_ack = true;
+
+			ret = ath10k_wmi_vdev_restart(ar, &rarg);
+		}
+		if (ret) {
+			ath10k_warn(ar,
+				    "rhodep inject: vdev_restart failed: %d\n",
+				    ret);
+			goto chan_change_failed;
+		}
+
+		/* Best-effort; START_RESP is unreliable for hidden vdev */
+		(void)ath10k_vdev_setup_sync(ar);
+
+		ret = ath10k_wmi_vdev_up(ar, ar->rhodep_inject.vdev_id, 0,
+					 ar->rhodep_inject.mac_addr);
+		if (ret) {
+			ath10k_warn(ar,
+				    "rhodep inject: vdev_up after restart failed: %d\n",
+				    ret);
+			goto chan_change_failed;
+		}
+
+		spin_lock_bh(&ar->rhodep_inject.lock);
+		ar->rhodep_inject.chanfreq = chanfreq;
+		spin_unlock_bh(&ar->rhodep_inject.lock);
+		ar->rhodep_inject.last_chan_change = jiffies;
+		ar->rhodep_inject.consec_fail = 0;
+		return 0;
+
+chan_change_failed:
+		ar->rhodep_inject.last_fail = jiffies;
+		ar->rhodep_inject.consec_fail =
+			min_t(u8, ar->rhodep_inject.consec_fail + 1, 255);
+		/* Keep the stale vdev; fall through by returning success.
+		 * On -ESHUTDOWN the fw-restart path will invalidate ->created
+		 * via ath10k_rhodep_inject_invalidate.
+		 */
+		return 0;
+	}
+
+	vid = ath10k_rhodep_find_free_vdev(ar, mon_vdev_id);
+	if (vid < 0) {
+		ath10k_warn(ar, "rhodep inject: no free vdev slot\n");
+		return vid;
+	}
+
+	/* Derive inj MAC from monitor vif's MAC with LAA bit set, and
+	 * flip the low byte so it never collides with the monitor's own MAC
+	 * (which would confuse mac80211 rx-address filtering).
+	 */
+	if (!mon_mac_in || is_zero_ether_addr(mon_mac_in)) {
+		ath10k_warn(ar, "rhodep inject: invalid monitor MAC input (%pM), falling back to random\n",
+			    mon_mac_in);
+		/* Random LAA MAC as fallback -- fw needs a non-zero MAC. */
+		eth_random_addr(inj_mac);
+		inj_mac[0] |= 0x02;
+		inj_mac[0] &= ~0x01; /* unicast */
+		mon_mac = inj_mac;   /* item 5: avoid mac=(null) in the log below */
+		goto have_mac;
+	}
+	ether_addr_copy(inj_mac, mon_mac_in);
+	inj_mac[0] |= 0x02;   /* locally-administered */
+	inj_mac[5] ^= 0x01;   /* uniquify from monitor MAC */
+	mon_mac = mon_mac_in;
+have_mac:
+
+	/* rhodep Experiment 1 (Sep 2026): use AP vdev type, not STA.
+	 *
+	 * Loukious's v1 (WCN3998) uses STA and never does per-DA
+	 * peer_create -- on WCN3998 fw's wal_send_mgmt uses the self-peer
+	 * at vdev+0xc as the tx peer for ANY addr1. But WCN3990 fw's
+	 * wal_tx unicast-mgmt path is STRICTER: it DISCARDs unicast when
+	 * addr1 has no matching peer.
+	 *
+	 * Trying to fix that with per-DA peer_create hits a different fw
+	 * limit: on a peerless (never VDEV_UP'd) STA vdev, any peer_create
+	 * asserts cmnos_thread.c:4005:A. Loukious never triggers this
+	 * because his design has ONE peer only.
+	 *
+	 * Fix: use WMI_VDEV_TYPE_AP + VDEV_UP with self-BSSID. AP vdevs
+	 * accept VDEV_UP without a partner peer, AP self-peer serves as
+	 * wildcard tx peer for ALL addr1 unicast, and beacon-tx-offload
+	 * is not a problem because we never install a beacon template
+	 * and keep bcn_intval=0.
+	 *
+	 * See kernel/patches/wip-rhodep-loukious-hidden-sta/README.md for
+	 * the full multi-agent analysis of why this is the right design.
+	 */
+	ath10k_warn(ar, "rhodep inject: creating AP vdev id=%d inj_mac=%pM freq=%u\n",
+		    vid, inj_mac, chanfreq);
+
+	ret = ath10k_wmi_vdev_create(ar, vid, WMI_VDEV_TYPE_AP,
+				     WMI_VDEV_SUBTYPE_NONE, inj_mac);
+	if (ret) {
+		ath10k_warn(ar, "rhodep inject: vdev_create failed: %d\n", ret);
+		if (ret == -ESHUTDOWN) {
+			/* fw is dead / CRASH_FLUSH set. Track for the
+			 * (A) fw-dead early bailout in the chan-change branch.
+			 */
+			ar->rhodep_inject.last_fail = jiffies;
+			ar->rhodep_inject.consec_fail =
+				min_t(u8, ar->rhodep_inject.consec_fail + 1, 255);
+		}
+		return ret;
+	}
+	ar->free_vdev_map &= ~(1LL << vid);
+
+	arg.vdev_id = vid;
+	arg.channel.freq = chanfreq;
+	arg.channel.band_center_freq1 = chanfreq;
+	arg.channel.band_center_freq2 = 0;
+	arg.channel.mode = (chanfreq < 4000) ? MODE_11G : MODE_11A;
+	arg.channel.max_power = 40;      /* 0.5 dBm units -> 20 dBm */
+	arg.channel.max_reg_power = 40;
+	arg.channel.max_antenna_gain = 0;
+	arg.bcn_intval = 0;   /* no beacons */
+	arg.dtim_period = 0;
+	/* AP vdev requires a non-null ssid pointer when hidden_ssid=true
+	 * (WARN_ON in ath10k_wmi_tlv_op_gen_vdev_start). Provide a dummy
+	 * 0-length SSID so the TLV builder accepts it. Since bcn_intval=0
+	 * no beacons ever go out anyway; the SSID field is unused.
+	 */
+	{
+		static const u8 dummy_ssid[1] = { 0 };
+		arg.ssid = (u8 *)dummy_ssid;
+		arg.ssid_len = 0;
+	}
+	arg.hidden_ssid = true;    /* extra safety: never expose an SSID */
+	arg.disable_hw_ack = true; /* phantom AP; suppress ACKs on rx */
+
+	ret = ath10k_wmi_vdev_start(ar, &arg);
+	if (ret) {
+		ath10k_warn(ar, "rhodep inject: vdev_start failed: %d\n", ret);
+		goto err_delete;
+	}
+	/* msleep(150); vdev_setup_sync waits for START_RESP event that
+	 * doesn't fire reliably for the hidden vdev on WCN3990.
+	 */
+	msleep(150);
+
+	ret = ath10k_wmi_peer_create(ar, vid, inj_mac, WMI_PEER_TYPE_DEFAULT);
+	if (ret) {
+		ath10k_warn(ar, "rhodep inject: peer_create failed: %d\n", ret);
+		goto err_stop;
+	}
+	/* msleep(100); wait_for_peer_created times out (peer_map event
+	 * never fires for the hidden vdev's self-peer on WCN3990).
+	 */
+	msleep(100);
+
+	/* rhodep Experiment 1 (Sep 2026): VDEV_UP with self-BSSID.
+	 *
+	 * On AP vdevs the fw accepts VDEV_UP with an arbitrary BSSID and
+	 * no partner peer. Once UP, the fw's tx-scheduler classifies the
+	 * vdev as active-AP and uses the self-peer as bss_peer for ALL
+	 * mgmt/data tx. No per-DA peer_create needed; addr1 is respected
+	 * verbatim (spoofed SA/BSSID work).
+	 *
+	 * This is the piece that was missing when we ran as STA vdev.
+	 */
+	ret = ath10k_wmi_vdev_up(ar, vid, 0, inj_mac);
+	if (ret) {
+		ath10k_warn(ar, "rhodep inject: vdev_up failed: %d\n", ret);
+		/* peer_delete + fall through to err_stop */
+		ath10k_wmi_peer_delete(ar, vid, inj_mac);
+		goto err_stop;
+	}
+	msleep(50);
+
+	/* Publish atomically: reader in gen_mgmt_tx_send takes this same
+	 * spinlock to observe created + vdev_id consistently. Fill scalars
+	 * first, then flip the flag under the lock.
+	 */
+	spin_lock_bh(&ar->rhodep_inject.lock);
+	ar->rhodep_inject.vdev_id = vid;
+	ar->rhodep_inject.monitor_vdev_id = mon_vdev_id;
+	ar->rhodep_inject.chanfreq = chanfreq;
+	ether_addr_copy(ar->rhodep_inject.mac_addr, inj_mac);
+	ar->rhodep_inject.created = true;
+	spin_unlock_bh(&ar->rhodep_inject.lock);
+	ar->rhodep_inject.last_chan_change = jiffies;
+	ar->rhodep_inject.consec_fail = 0;
+	ath10k_warn(ar, "rhodep inject: helper vdev %d ready (mac=%pM)\n",
+		    vid, mon_mac);
+	return 0;
+
+err_stop:
+	ath10k_wmi_vdev_stop(ar, vid);
+	msleep(100);
+err_delete:
+	ath10k_wmi_vdev_delete(ar, vid);
+	ar->free_vdev_map |= 1LL << vid;
+	return ret;
+}
+
+/* Public: called from wmi-tlv.c to translate a monitor vdev_id to the
+ * hidden inject vdev_id, if the injector has been set up.
+ * Returns the vdev_id to use (either hidden or original), never fails.
+ */
+u32 ath10k_rhodep_inject_vdev_for_mon(struct ath10k *ar, u32 mon_vdev_id)
+{
+	u32 out;
+	spin_lock_bh(&ar->rhodep_inject.lock);
+	if (ar->rhodep_inject.created &&
+	    ar->rhodep_inject.monitor_vdev_id == mon_vdev_id)
+		out = ar->rhodep_inject.vdev_id;
+	else
+		out = mon_vdev_id;
+	spin_unlock_bh(&ar->rhodep_inject.lock);
+	return out;
+}
+
+/* Public: teardown helper for driver shutdown.
+ * MUST NOT hold rhodep_inject.lock (spinlock) across msleep/WMI blocking
+ * ops. Sequence:
+ *   1. Under spinlock: snapshot vdev_id/mac, clear ->created, release lock.
+ *      -> Any inflight reader in gen_mgmt_tx_send now sees created==false
+ *         and routes to the monitor vdev (harmless).
+ *   2. Under conf_mutex only: do the sleeping WMI teardown of the vdev.
+ */
+/* rhodep: retune the hidden AP inject vdev to `new_freq` when the monitor
+ * vif changes channel. WCN3990 has ONE radio (one PDEV); if the hidden AP
+ * vdev is UP on 2.4 GHz and mac80211 moves the monitor vif to 5 GHz, the
+ * fw arbitrates in favor of the AP-typed vdev and pins the radio to 2.4
+ * GHz -> monitor RX gets ZERO packets on 5 GHz (airodump --band abg
+ * shows no 5 GHz APs). Fix: piggyback on the chanctx switch path
+ * (ath10k_mac_update_vif_chan) and vdev_down/restart/up the hidden vdev
+ * onto the same new freq the monitor just moved to.
+ *
+ * Uses the same in-place restart shape as ensure_inject_vdev's Fix (C),
+ * without the rate-limit -- this path is driven by mac80211 chanctx
+ * events, not by aireplay's burst, so it happens at most a few Hz.
+ *
+ * Called under conf_mutex; must NOT hold rhodep_inject.lock during the
+ * WMI calls.
+ */
+int ath10k_rhodep_inject_retune(struct ath10k *ar, u32 new_freq)
+{
+	struct wmi_vdev_start_request_arg rarg = {};
+	static const u8 dummy_ssid[1] = { 0 };
+	u8 vdev_id;
+	u8 mac[ETH_ALEN];
+	int ret;
+
+	lockdep_assert_held(&ar->conf_mutex);
+
+	if (!ar->rhodep_inject.created)
+		return 0;
+	if (ar->rhodep_inject.chanfreq == new_freq)
+		return 0;
+
+	vdev_id = ar->rhodep_inject.vdev_id;
+	ether_addr_copy(mac, ar->rhodep_inject.mac_addr);
+
+	ath10k_info(ar,
+		    "rhodep inject: chanctx retune %u->%u vdev=%u\n",
+		    ar->rhodep_inject.chanfreq, new_freq, vdev_id);
+
+	ret = ath10k_wmi_vdev_down(ar, vdev_id);
+	if (ret == -ESHUTDOWN)
+		return ret;
+	/* other errors: press on with restart */
+
+	reinit_completion(&ar->vdev_setup_done);
+	reinit_completion(&ar->vdev_delete_done);
+
+	rarg.vdev_id = vdev_id;
+	rarg.channel.freq = new_freq;
+	rarg.channel.band_center_freq1 = new_freq;
+	rarg.channel.band_center_freq2 = 0;
+	rarg.channel.mode = (new_freq < 4000) ? MODE_11G : MODE_11A;
+	rarg.channel.max_power = 40;
+	rarg.channel.max_reg_power = 40;
+	rarg.channel.max_antenna_gain = 0;
+	rarg.bcn_intval = 0;
+	rarg.dtim_period = 0;
+	rarg.ssid = (u8 *)dummy_ssid;
+	rarg.ssid_len = 0;
+	rarg.hidden_ssid = true;
+	rarg.disable_hw_ack = true;
+
+	ret = ath10k_wmi_vdev_restart(ar, &rarg);
+	if (ret) {
+		ath10k_warn(ar,
+			    "rhodep inject: chanctx vdev_restart %u failed: %d\n",
+			    new_freq, ret);
+		return ret;
+	}
+
+	(void)ath10k_vdev_setup_sync(ar);
+
+	ret = ath10k_wmi_vdev_up(ar, vdev_id, 0, mac);
+	if (ret) {
+		ath10k_warn(ar,
+			    "rhodep inject: chanctx vdev_up %u failed: %d\n",
+			    new_freq, ret);
+		return ret;
+	}
+
+	spin_lock_bh(&ar->rhodep_inject.lock);
+	ar->rhodep_inject.chanfreq = new_freq;
+	spin_unlock_bh(&ar->rhodep_inject.lock);
+	ar->rhodep_inject.last_chan_change = jiffies;
+	ar->rhodep_inject.consec_fail = 0;
+	return 0;
+}
+
+void ath10k_rhodep_inject_teardown(struct ath10k *ar)
+{
+	u8 vdev_id;
+	u8 mac[ETH_ALEN];
+	bool did;
+
+	spin_lock_bh(&ar->rhodep_inject.lock);
+	did = ar->rhodep_inject.created;
+	if (did) {
+		vdev_id = ar->rhodep_inject.vdev_id;
+		ether_addr_copy(mac, ar->rhodep_inject.mac_addr);
+		ar->rhodep_inject.created = false;
+	}
+	spin_unlock_bh(&ar->rhodep_inject.lock);
+
+	if (!did)
+		return;
+
+	mutex_lock(&ar->conf_mutex);
+	ath10k_wmi_peer_delete(ar, vdev_id, mac);
+	msleep(100);
+	ath10k_wmi_vdev_stop(ar, vdev_id);
+	msleep(100);
+	ath10k_wmi_vdev_delete(ar, vdev_id);
+	msleep(100);
+	ar->free_vdev_map |= 1LL << vdev_id;
+	mutex_unlock(&ar->conf_mutex);
+}
+
+/* rhodep item 4: driver-side-only invalidation on fw crash.
+ * Called from ath10k_core_restart before CRASH_FLUSH is set. Fw is
+ * about to reboot so its hidden vdev is gone anyway; just clear our
+ * side so the next mgmt-tx worker iteration recreates it.
+ * Uses spinlock only (no WMI, no mutex, no msleep) so it is safe to
+ * call from the restart_work handler holding conf_mutex.
+ */
+void ath10k_rhodep_inject_invalidate(struct ath10k *ar)
+{
+	spin_lock_bh(&ar->rhodep_inject.lock);
+	if (ar->rhodep_inject.created) {
+		ath10k_info(ar,
+			    "rhodep: fw restart - invalidating hidden vdev %u\n",
+			    ar->rhodep_inject.vdev_id);
+		ar->free_vdev_map |= 1LL << ar->rhodep_inject.vdev_id;
+		ar->rhodep_inject.created = false;
+	}
+	memset(ar->rhodep_inject.peer_cache, 0,
+	       sizeof(ar->rhodep_inject.peer_cache));
+	ar->rhodep_inject.peer_cache_next = 0;
+	spin_unlock_bh(&ar->rhodep_inject.lock);
+}
