                <property name="visible">True</property>
                <property name="label" translatable="yes">Start Hashcat</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow"><property name="visible">True</property>
                <property name="min-content-height">120</property><property name="shadow-type">in</property>
                <child>
                  <object class="GtkTextView" id="hc_output">
                    <property name="visible">True</property><property name="editable">False</property>
                    <property name="wrap-mode">word-char</property><property name="monospace">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing><property name="position">4</property><property name="tab-expand">True</property></packing>
