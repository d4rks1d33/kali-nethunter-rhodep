-		 * A listener. */
+		/* Offer NFC-F listen too. This controller does not light its
+		 * listen front-end for NFC-A alone -- it only wakes when NFC-F
+		 * listen is also offered. The NFC-DEP/Type-3 peer that NFC-F
+		 * would normally present has been neutralised in the emulation
+		 * path (LF_PROTOCOL_TYPE = 0, LF_T3T_FLAGS = 0), so offering it
+		 * here only powers the analog front-end; the NFC-A field then
+		 * reaches the host or the eSE via the routing table. */
 		cmd.disc_configs[cmd.num_disc_configs].rf_tech_and_mode =
 			NCI_NFC_F_PASSIVE_LISTEN_MODE;
 		cmd.disc_configs[cmd.num_disc_configs].frequency = 1;
