# pager-dnsmasq.service -- dedicated dnsmasq (DHCP/DNS) on br-pager only.
#
# Part of: extra-tools/pineapple-pager/systemd/
# A DEDICATED dnsmasq bound to br-pager ONLY (net/dnsmasq.conf). Serves DHCP to
# the Pager LAN (172.16.52.100-250). NOT the system dnsmasq; its own conf/pid/
# lease files under /opt/pineapple-pager. Never serves DHCP on the phone's wlan.

[Unit]
Description=WiFi Pineapple Pager dnsmasq (DHCP/DNS on br-pager only)
After=pager-net.service
Requires=pager-net.service
PartOf=pager.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /opt/pineapple-pager/run /var/log/pineapple-pager
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/opt/pineapple-pager/net/dnsmasq.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=pager.target
