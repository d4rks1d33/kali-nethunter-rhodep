From: Kali NetHunter rhodep port
Subject: [PATCH] nfc: route the MIFARE listen to the embedded secure element

Patch 0112 enumerates the eSE (NFCEE id 0x83 on rhodep, the one whose supported
protocol is MIFARE), which is where an Android transit app provisions a MIFARE
card. The applet persists across the OS change and the eSE runs Crypto1 itself,
so to make the card answer a reader from Linux the controller only has to enable
that NFCEE and route the MIFARE listen to it.

Remember the eSE's NFCEE id when it turns up in an NFCEE_DISCOVER_NTF (the one
that lists the MIFARE protocol). When card emulation is requested and an eSE was
found, NFCEE_MODE_SET(ENABLE) it, keep it powered with NFCEE_POWER_AND_LINK_CTRL
and route the MIFARE listen to that NFCEE instead of the host.

The decisive detail, confirmed by reverse engineering the vendor HAL and a live
A/B capture (docs/felica_suppress_re.md): on the S3FWRN5 the NFC-F listen slot
*is* an autonomous FeliCa / Type-3 responder. Whenever NFC-F LISTEN is offered
in RF_DISCOVER and NFC-F / NFC-DEP is routed, the firmware brings up its own
FeliCa peer and answers the reader itself -- the reader sees FeliCa (an IDm)
instead of the provisioned MIFARE card and the host gets 0 RF_INTF_ACTIVATED_NTF.
LF_PROTOCOL_TYPE / LF_T3T_FLAGS cannot carve the RF carrier away from that
responder (they are coupled on this firmware: LF_PROTOCOL_TYPE=0 kills the RF
entirely). The only reliable suppression is to stop offering NFC-F and stop
routing NFC-F / NFC-DEP, so the firmware has no NFC-F listen slot to arm the
peer with, and to arm NFC-A LISTEN routed to the eSE instead.

Concretely, on the emulation (listen) path:

  - RF_DISCOVER offers NFC-A LISTEN only, not NFC-A + NFC-F. On the wire:
    21 03 03 01 80 01 (num_configs=1, NFC-A passive listen 0x80).

  - The listen mode routing table is three entries, all to the eSE at the
    vendor OFFHOST_AID_ROUTE_PWR_STATE power state 0x3B; the NFC-F technology
    and NFC-DEP protocol "RF primer" entries are removed:

      1) NFC-A technology  -> eSE  @ power-state 0x3B
      2) MIFARE  (0x80)    -> eSE  @ power-state 0x3B
      3) ISO-DEP (0x04)    -> eSE  @ power-state 0x3B  (DEFAULT_ISODEP_ROUTE)

    On the wire:
      21 01 11 00 03 00 03 3B 83 00 01 03 3B 83 80 01 03 3B 83 04
    (plen 0x11 = 17, more=0, num_entries=3).

  - LF_PROTOCOL_TYPE = 0 is sent unconditionally on the listen path as belt and
    suspenders (no DEP-over-F even if NFC-F ever appears). LF_T3T_FLAGS=0 is NOT
    sent: with no matching LF_T3T_IDENTIFIERS the S3FWRN5 rejects it (SET_CONFIG
    status 0x9) and leaves the listen config inconsistent.

  - After NFCEE_MODE_SET(0x83, ENABLE) and before the LMRT, send an NCI 2.0
    NFCEE_POWER_AND_LINK_CTRL (GID 0x2 OID 0x3, on the wire 20 03 02 83 03) so
    the eSE stays powered and the NFCC<->eSE link stays up during listen. It is
    fire-and-forget: a non-OK response is harmless, MIFARE routing is a pure
    LMRT operation and does not depend on it.

The on-air value octets of each LMRT entry are, per NCI 2.0 and struct
nci_lmrt_{tech,proto}_entry, NFCEE-id then power-state then technology/protocol.
(The RE notes tabulate the two middle octets power-state-first; that is a
documentation convention, not the wire order.)

Do NOT set any LA_* config (LA_NFCID1, LA_SEL_INFO, ...) from the host on the
eSE path: the eSE owns the NFC-A identity; a host LA_NFCID1 would override the
real card's UID and a host LA_SEL_INFO=0x08 would advertise ISO-DEP instead of
MIFARE, so the reader would never see the provisioned card.

The RF_NFCEE_ACTION_NTF (GID 0x1 OID 0x9) is logged: it is the controller's
signal that it handed the RF interface (the reader's NFC-A field) to an NFCEE,
i.e. the direct evidence that the MIFARE listen fired on the eSE 0x83.

--- a/include/net/nfc/nci.h
+++ b/include/net/nfc/nci.h
@@ -132,6 +132,7 @@
 #define NCI_LA_NFCID1						0x33
 #define NCI_LA_SEL_INFO						0x32
 #define NCI_LF_PROTOCOL_TYPE					0x50
+#define NCI_LF_T3T_FLAGS					0x3f
 #define NCI_LF_CON_BITR_F					0x54
 
 /* NCI Configuration Parameters masks */
@@ -293,8 +294,12 @@
 #define NCI_LMRT_TYPE_PROTOCOL					0x01
 /* NFCEE id of the host (the AP itself) */
 #define NCI_NFCEE_ID_HOST					0x00
-/* Power states bitmask: vendor programs 0x3b, not 0x3f (RE of Samsung NFC HAL) */
+/* Power states bitmask: vendor programs 0x3b for the offhost/eSE routes
+ * (OFFHOST_AID_ROUTE_PWR_STATE, RE of Samsung NFC HAL). */
 #define NCI_LMRT_POWER_STATE_ALL				0x3b
+/* All power states (0x3f) -- used for the NFC-F/NFC-DEP host entries that only
+ * prime the analog front-end so the F listener is up in every power state. */
+#define NCI_LMRT_POWER_STATE_RF					0x3f
 struct nci_lmrt_tech_entry {
 	__u8	type;		/* NCI_LMRT_TYPE_TECHNOLOGY */
 	__u8	len;		/* 3 */
@@ -353,6 +358,19 @@
 	__u8	nfcee_mode;
 } __packed;
 
+/* NCI 2.0 NFCEE_POWER_AND_LINK_CTRL: GID 0x2 (NFCEE mgmt), OID 0x3 -> opcode
+ * 0x203, first on-wire byte 0x20. Keeps the eSE powered and the NFCC<->eSE link
+ * up so the eSE can answer over RF in the requested power states. PLI 0x03 =
+ * NFC forwarding enabled AND NFCC keeps power+link always active. */
+#define NCI_OP_NFCEE_POWER_AND_LINK_CTRL_CMD \
+				nci_opcode_pack(NCI_GID_NFCEE_MGMT, 0x03)
+/* PLI: bit0 = keep NFCEE powered, bit1 = keep NFCC<->NFCEE link active. */
+#define NCI_NFCEE_PWR_LINK_ALWAYS_ON	0x03
+struct nci_nfcee_power_and_link_ctrl_cmd {
+	__u8	nfcee_id;
+	__u8	pli;
+} __packed;
+
 #define NCI_OP_CORE_GET_CONFIG_CMD	nci_opcode_pack(NCI_GID_CORE, 0x03)
 
 /* ----------------------- */
--- a/include/net/nfc/nci_core.h
+++ b/include/net/nfc/nci_core.h
@@ -254,6 +254,16 @@
 	__u8			manufact_id;
 	__u32			manufact_specific_info;
 
+	/* NFCEE id of the embedded secure element (the one that lists the
+	 * MIFARE protocol), learned from NFCEE_DISCOVER_NTF. 0 = none found.
+	 * A provisioned MIFARE card lives here; routing the MIFARE listen to
+	 * this NFCEE lets it answer a reader. */
+	__u8			ese_nfcee_id;
+	/* NFCEE status byte from NFCEE_DISCOVER_NTF for the eSE (0x01 =
+	 * CONNECTED/ENABLED). Used to skip a redundant NFCEE_MODE_SET(ENABLE)
+	 * that the S3FWRN5 answers with status 0x03 (REJECTED). */
+	__u8			ese_enabled;
+
 	/* Save RF Discovery ID or NFCEE ID under conn_create */
 	struct dest_spec_params cur_params;
 	/* Save destination type under conn_create */
--- a/net/nfc/nci/ntf.c
+++ b/net/nfc/nci/ntf.c
@@ -982,6 +982,26 @@
 
 	nfcee_ntf = (struct nci_nfcee_discover_ntf *)skb->data;
 
+	/* The NCI 2.0 NFCEE_DISCOVER_NTF is variable length: id, status,
+	 * num_protocols, protocols[], num_tlvs, tlvs[]. Scan the supported
+	 * protocols for MIFARE (0x80); the NFCEE that lists it is the embedded
+	 * secure element holding a provisioned MIFARE card. Remember its id so
+	 * the emulation path can route the MIFARE listen to it. */
+	if (skb->len >= 3) {
+		u8 nfcee_id = skb->data[0];
+		u8 num_proto = skb->data[2];
+		unsigned int i;
+
+		for (i = 0; i < num_proto && 3 + i < skb->len; i++) {
+			if (skb->data[3 + i] == NCI_RF_PROTOCOL_MIFARE) {
+				ndev->ese_nfcee_id = nfcee_id;
+				/* Byte 1 is the NFCEE status (0x01 = ENABLED). */
+				ndev->ese_enabled = skb->data[1];
+				break;
+			}
+		}
+	}
+
 	/* NFCForum NCI 9.2.1 HCI Network Specific Handling
 	 * If the NFCC supports the HCI Network, it SHALL return one,
 	 * and only one, NFCEE_DISCOVER_NTF with a Protocol type of
@@ -1059,6 +1079,17 @@
 		break;
 
 	case NCI_OP_RF_NFCEE_ACTION_NTF:
+		/* Diagnostic: the RF_NFCEE_ACTION_NTF (GID 0x1 OID 0x9) is the
+		 * controller telling us it handed the RF interface to an NFCEE.
+		 * When the reader's NFC-A field is routed to the eSE (0x83) this
+		 * is the direct evidence that the MIFARE listen fired on the eSE.
+		 * Payload is NFCEE id, trigger, then supported-data-length + data;
+		 * log the id and trigger. */
+		if (skb->len >= 2)
+			pr_info("RF_NFCEE_ACTION_NTF: nfcee_id 0x%x trigger 0x%x\n",
+				skb->data[0], skb->data[1]);
+		else
+			pr_info("RF_NFCEE_ACTION_NTF (len %u)\n", skb->len);
 		break;
 
 	default:
--- a/net/nfc/nci/core.c
+++ b/net/nfc/nci/core.c
@@ -247,6 +247,26 @@
 	nci_send_cmd(ndev, NCI_OP_CORE_SET_CONFIG_CMD, (3 + param->len), &cmd);
 }
 
+/* Isolation switch for card emulation: when set, ignore any embedded secure
+ * element learned from NFCEE_DISCOVER_NTF and force the HOST listen path
+ * (LA_* NFC-A identity + LMRT to the host 0x00 + T2T/FRAME listen map). This
+ * lets a single build test host listen (does the RF front-end arm at all?)
+ * versus eSE routing, without reflashing. Use:  modprobe nci emulate_host=1
+ * or, at runtime:  echo 1 > /sys/module/nci/parameters/emulate_host  */
+static bool emulate_host;
+module_param(emulate_host, bool, 0644);
+MODULE_PARM_DESC(emulate_host,
+		 "force host card-emulation path, ignore the eSE (default 0)");
+
+/* Effective eSE NFCEE id for the emulation path: 0 (host path) when the
+ * emulate_host isolation switch is on, otherwise the id learned from
+ * NFCEE_DISCOVER_NTF. Both nci_start_poll() and the listen mode routing
+ * builder use this so the two stay consistent. */
+static inline u8 nci_emu_ese_id(const struct nci_dev *ndev)
+{
+	return emulate_host ? 0 : ndev->ese_nfcee_id;
+}
