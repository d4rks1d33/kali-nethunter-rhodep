+#define ATH10K_RHODEP_MGMT_TX_STALE_JIFFIES msecs_to_jiffies(300)
+
+/* rhodep: release one WMI HTC credit that the fw failed to return.
+ * Mirrors what ath10k_htc_process_credit_report would have done for a
+ * real completion. WCN3990 has ONLY ONE HTC WMI credit; when the fw
+ * drops a mgmt-tx completion event (observed during aireplay-ng
+ * directed probe bursts), the credit is leaked forever. Without this,
+ * ath10k_wmi_cmd_send times out after 3s and calls
+ * ath10k_core_start_recovery, which sets CRASH_FLUSH and produces the
+ * "-108 avalanche" that breaks all subsequent tx until recovery.
