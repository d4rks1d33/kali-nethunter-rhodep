# Reference: <https://postmarketos.org/vendorkernel>
# Config based on arm64 defconfig plus the options required by postmarketOS.

maintainer="d4rks1d3 <teogorqui1@hotmail.es>"
pkgname=linux-motorola-rhodep
pkgver=7.2_rc5
pkgrel=0
pkgdesc="Mainline kernel for the Motorola Moto G82 5G"
url="https://kernel.org"
arch="aarch64"
license="GPL-2.0-only"
_kver=${pkgver//_/-}
makedepends="
