# Built artifacts (regenerate with the scripts / pmbootstrap)
*.deb
*.img
*.apk
*.tar.gz
*.tar.xz
*.sqfs
*.bmap

# Pandora keyfob .hex firmwares (not ours to redistribute - users supply their own)
extra-tools/pandora-emu/firmwares/*.hex
# Pandora emu build artifacts (install.sh runs `make` to regenerate them)
extra-tools/pandora-emu/src/pandora_emu/libpandora.so
extra-tools/pandora-emu/src/pandora_emu/native/libpandora.so
extra-tools/pandora-emu/src/pandora_emu/native/*.o

# ...but DO include the documentation screenshots
!docs/screenshots/
!docs/screenshots/*.png
!docs/screenshots/*.jpg
